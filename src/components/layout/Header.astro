---
import Logo from './Logo.astro';
import { NAV, SERVICES_NAV, SECTORS_NAV, COMPANY_NAV } from '../../data/nav';

const linkCls = 'inline-flex min-h-11 items-center shrink-0 whitespace-nowrap px-2.5 text-[11px] uppercase tracking-[0.18em] xl:px-3.5 xl:tracking-[0.2em] text-muted transition-colors hover:text-cream';
---
<header id="site-header" data-scrolled="false"
  class="site-header fixed left-1/2 z-50 w-[94%] max-w-[1200px] -translate-x-1/2 rounded-full glass"
  style="top: calc(env(safe-area-inset-top) + 44px)">
  <div class="hdr-inner flex items-center justify-between gap-2 py-1.5 pl-4 pr-1.5 lg:pl-5 lg:pr-2 xl:pl-6">
    <Logo class="shrink-0" />

    <nav aria-label="Principal" class="hidden items-center lg:flex">
      <div class="dd relative" data-dd>
        <button type="button" class={linkCls + ' gap-1.5'} aria-expanded="false" aria-controls="dd-servicios">
          Servicios
          <svg viewBox="0 0 10 6" class="h-1.5 w-2.5 transition-transform duration-300 [[aria-expanded=true]>&]:rotate-180" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m1 1 4 4 4-4" /></svg>
        </button>
        <ul id="dd-servicios" class="dd-panel absolute left-0 top-full mt-3 w-72 rounded-3xl border border-white/10 bg-[rgb(18_18_18/0.96)] p-2 shadow-[0_24px_60px_-12px_rgb(0_0_0/0.8)]">
          {SERVICES_NAV.map((l) => (
            <li><a href={l.href} class="block rounded-2xl px-4 py-3 text-sm text-cream/90 transition-colors hover:bg-white/10 hover:text-gold-200">{l.label}</a></li>
          ))}
        </ul>
      </div>
      <div class="dd relative" data-dd>
        <button type="button" class={linkCls + ' gap-1.5'} aria-expanded="false" aria-controls="dd-sectores">
          Sectores
          <svg viewBox="0 0 10 6" class="h-1.5 w-2.5 transition-transform duration-300 [[aria-expanded=true]>&]:rotate-180" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m1 1 4 4 4-4" /></svg>
        </button>
        <ul id="dd-sectores" class="dd-panel absolute left-0 top-full mt-3 w-72 rounded-3xl border border-white/10 bg-[rgb(18_18_18/0.96)] p-2 shadow-[0_24px_60px_-12px_rgb(0_0_0/0.8)]">
          {SECTORS_NAV.map((l) => (
            <li><a href={l.href} class="block rounded-2xl px-4 py-3 text-sm text-cream/90 transition-colors hover:bg-white/10 hover:text-gold-200">{l.label}</a></li>
          ))}
        </ul>
      </div>
      {NAV.links.map((l) => <a href={l.href} class={linkCls}>{l.label}</a>)}
    </nav>

    <div class="flex shrink-0 items-center gap-1">
      <a href="/contacto#formulario" data-open-form
        class="hidden min-h-11 items-center rounded-full bg-white whitespace-nowrap px-5 text-[11px] font-semibold uppercase tracking-[0.2em] text-black xl:px-6 transition duration-300 hover:bg-gold-200 active:scale-[0.97] sm:inline-flex">
        Reservar plaza
      </a>
      <button type="button" id="menu-toggle" aria-expanded="false" aria-controls="mobile-menu" aria-label="Abrir menú"
        class="relative flex h-11 w-11 items-center justify-center rounded-full text-cream transition-colors hover:bg-white/10 lg:hidden">
        <span class="sr-only">Menú</span>
        <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="M4 8h16M4 16h16" /></svg>
      </button>
    </div>
  </div>
</header>

<div id="mobile-menu" class="mobile-menu fixed inset-0 z-[60] overflow-y-auto bg-ink/95 backdrop-blur-xl lg:hidden" aria-label="Menú" role="dialog" aria-modal="true" inert>
  <div class="flex min-h-[100svh] flex-col px-6" style="padding-top: calc(env(safe-area-inset-top) + 12px); padding-bottom: calc(env(safe-area-inset-bottom) + 20px)">
    <div class="flex items-center justify-between">
      <Logo />
      <button type="button" id="menu-close" aria-label="Cerrar menú" class="flex h-11 w-11 items-center justify-center rounded-full text-cream transition-colors hover:bg-white/10">
        <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg>
      </button>
    </div>

    <nav aria-label="Móvil" class="mt-8 flex flex-1 flex-col gap-1">
      <div class="m-item" style="--i:0">
        <p class="mb-1 text-[11px] uppercase tracking-[0.25em] text-gold-400">Servicios</p>
        <ul class="mb-4 grid gap-0.5">
          {SERVICES_NAV.map((l) => <li><a href={l.href} data-menu-link class="flex min-h-11 items-center font-display text-[28px] italic leading-tight text-cream">{l.label}</a></li>)}
        </ul>
      </div>
      <div class="m-item" style="--i:1">
        <p class="mb-1 text-[11px] uppercase tracking-[0.25em] text-gold-400">Sectores</p>
        <ul class="mb-4 grid gap-0.5">
          {SECTORS_NAV.map((l) => <li><a href={l.href} data-menu-link class="flex min-h-11 items-center font-display text-[24px] italic leading-tight text-cream/90">{l.label}</a></li>)}
        </ul>
      </div>
      <div class="m-item" style="--i:2">
        <p class="mb-1 text-[11px] uppercase tracking-[0.25em] text-gold-400">Empresa</p>
        <ul class="grid gap-0.5">
          {COMPANY_NAV.map((l) => <li><a href={l.href} data-menu-link class="flex min-h-11 items-center font-display text-[24px] italic leading-tight text-cream/90">{l.label}</a></li>)}
        </ul>
      </div>
    </nav>

    <a href="/contacto#formulario" data-open-form data-menu-link
      class="m-item bg-gold mt-8 flex min-h-14 items-center justify-center rounded-full text-sm font-semibold uppercase tracking-[0.2em]" style="--i:3">
      Reservar plaza
    </a>
  </div>
</div>

<style>
  .site-header {
    transition: top 0.4s var(--ease-out-expo), background-color 0.4s, box-shadow 0.4s;
  }
  .hdr-inner { transition: padding 0.4s var(--ease-out-expo); }
  .site-header[data-scrolled='true'] .hdr-inner { padding-top: 0; padding-bottom: 0; }
  .site-header[data-scrolled='true'] {
    top: calc(env(safe-area-inset-top) + 10px) !important;
    background: rgb(10 10 10 / 0.82);
    box-shadow: 0 12px 40px -12px rgb(0 0 0 / 0.7);
  }
  .dd-panel {
    opacity: 0; visibility: hidden; transform: translateY(-6px);
    transition: opacity 0.25s, transform 0.3s var(--ease-out-expo), visibility 0.25s;
  }
  .dd-panel[data-open='true'] { opacity: 1; visibility: visible; transform: none; }
  .mobile-menu { opacity: 0; visibility: hidden; overscroll-behavior: contain; transition: opacity 0.3s, visibility 0.3s; }
  .mobile-menu[data-open='true'] { opacity: 1; visibility: visible; }
  .m-item {
    opacity: 0; transform: translateY(14px);
    transition: opacity 0.5s calc(var(--i) * 70ms + 80ms), transform 0.6s var(--ease-out-expo) calc(var(--i) * 70ms + 80ms);
  }
  .mobile-menu[data-open='true'] .m-item { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: reduce) {
    .m-item { opacity: 1; transform: none; }
  }
</style>

<script>
  const header = document.getElementById('site-header') as HTMLElement | null;
  const menu = document.getElementById('mobile-menu') as HTMLElement | null;
  const toggle = document.getElementById('menu-toggle') as HTMLButtonElement | null;
  const closeBtn = document.getElementById('menu-close') as HTMLButtonElement | null;

  // Cápsula más opaca y compacta al hacer scroll
  const onScroll = () => header?.setAttribute('data-scrolled', String(window.scrollY > 40));
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  // Menú móvil
  function setMenu(open: boolean) {
    if (!menu || !toggle) return;
    menu.dataset.open = String(open);
    if (open) menu.removeAttribute('inert'); else menu.setAttribute('inert', '');
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
    document.documentElement.style.overflow = open ? 'hidden' : '';
    document.querySelectorAll('main, footer, #site-header').forEach((el) => { if (open) el.setAttribute('inert', ''); else el.removeAttribute('inert'); });
    if (open) closeBtn?.focus(); else if (document.activeElement && menu.contains(document.activeElement)) toggle.focus();
  }
  toggle?.addEventListener('click', () => setMenu(menu?.dataset.open !== 'true'));
  closeBtn?.addEventListener('click', () => setMenu(false));
  menu?.querySelectorAll('[data-menu-link]').forEach((a) => a.addEventListener('click', () => setMenu(false)));
  window.matchMedia('(min-width: 1024px)').addEventListener('change', (e) => { if (e.matches) setMenu(false); });

  // Desplegables de escritorio
  const dds = Array.from(document.querySelectorAll<HTMLElement>('[data-dd]'));
  function setDd(dd: HTMLElement, open: boolean) {
    dd.querySelector('button')?.setAttribute('aria-expanded', String(open));
    dd.querySelector<HTMLElement>('.dd-panel')!.dataset.open = String(open);
  }
  const closeAll = (except?: HTMLElement) => dds.forEach((d) => { if (d !== except) setDd(d, false); });
  const hoverCapable = window.matchMedia('(hover: hover)');
  dds.forEach((dd) => {
    const btn = dd.querySelector('button')!;
    let t: number;
    btn.addEventListener('click', () => {
      // Con ratón el hover ya lo abre: el clic nunca lo cierra. Táctil/teclado: alterna.
      const open = hoverCapable.matches && dd.matches(':hover') ? true : btn.getAttribute('aria-expanded') !== 'true';
      closeAll(dd); setDd(dd, open);
    });
    dd.addEventListener('mouseenter', () => { if (hoverCapable.matches) { clearTimeout(t); closeAll(dd); setDd(dd, true); } });
    dd.addEventListener('mouseleave', () => { if (hoverCapable.matches) t = window.setTimeout(() => setDd(dd, false), 150); });
    dd.addEventListener('focusout', (e) => { if (!dd.contains((e as FocusEvent).relatedTarget as Node)) setDd(dd, false); });
  });
  document.addEventListener('click', (e) => { if (!(e.target as HTMLElement).closest('[data-dd]')) closeAll(); });

  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    if (menu?.dataset.open === 'true') setMenu(false);
    const openDd = dds.find((d) => d.querySelector('button')?.getAttribute('aria-expanded') === 'true');
    if (openDd) { setDd(openDd, false); openDd.querySelector('button')?.focus(); }
  });
</script>
