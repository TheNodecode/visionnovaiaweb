---
interface Props { class?: string }
const { class: cls = '' } = Astro.props;
---
<a href="/" class:list={['inline-flex min-h-11 items-center gap-2.5', cls]} aria-label="Visión Nova, inicio">
  <svg viewBox="0 0 64 64" class="h-7 w-7 shrink-0" aria-hidden="true">
    <defs><linearGradient id="logo-g" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#F1D9A0" /><stop offset="1" stop-color="#B8862F" /></linearGradient></defs>
    <path fill="url(#logo-g)" d="M30 8c1 11 4 18 9 21-5 3-8 10-9 27-1-17-4-24-9-27 5-3 8-10 9-21z" transform="translate(-2 0)" />
    <path fill="url(#logo-g)" d="M47 11c.4 4 1.5 6 3.5 7-2 1-3.1 3-3.5 7-.4-4-1.5-6-3.5-7 2-1 3.1-3 3.5-7z" />
  </svg>
  <span class="font-display text-[22px] italic leading-none tracking-tight text-cream">visión nova</span>
</a>
