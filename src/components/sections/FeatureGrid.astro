---
import SectionHeading from '../ui/SectionHeading.astro';
import Icon from '../ui/Icon.astro';
import type { IconName } from '../ui/icon-names';

interface Props { id?: string; eyebrow?: string; title: string; items: { title: string; text: string; icon: IconName }[]; tone?: 'dark' | 'light' }
const { id, eyebrow, title, items, tone = 'dark' } = Astro.props;
const cols = items.length % 3 === 0 || items.length > 4 ? 'lg:grid-cols-3' : 'lg:grid-cols-2';
---
<section id={id} class:list={['relative bg-ink py-16 md:py-24', tone === 'light' && 'section-light']}>
  <div class="container-x">
    <div data-reveal><SectionHeading eyebrow={eyebrow} title={title} align="left" /></div>
    <ul class:list={['mt-12 grid gap-4 sm:grid-cols-2 md:mt-16 md:gap-5', cols]} data-reveal-stagger>
      {items.map((it) => (
        <li class="glass group relative overflow-hidden rounded-[28px] p-7 transition-colors duration-500 hover:border-gold-400/25 md:p-8">
          <span class="flex h-11 w-11 items-center justify-center rounded-full border border-gold-400/25 text-gold-200 transition-colors duration-500 group-hover:bg-gold-400/10">
            <Icon name={it.icon} size={20} />
          </span>
          <h3 class="mt-8 font-display text-[26px] italic leading-[1.1] text-cream text-balance md:text-[28px]">{it.title}</h3>
          <p class="mt-3 text-[15px] leading-relaxed text-muted text-pretty">{it.text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
