---
// Galería del caso real (CEM Valderas, clínica dental): creatividades gráficas, carruseles educativos y fotos de la clínica.
// Reglas: sin pacientes, sin cifras ni resultados. Las ofertas y los textos de las creatividades son de la clínica.
// Móvil: carril horizontal con snap para las creatividades y mosaico 2×2 para la clínica. Escritorio: fila de cinco y mosaico de cuatro.
import Eyebrow from '../ui/Eyebrow.astro';
import { CLIENT, CEM_ADS, CEM_CLINIC } from '../../data/media';

interface Props { id?: string; tone?: 'dark' | 'light'; titleHtml?: string; lead?: string }
const {
  id = 'galeria-caso',
  tone = 'dark',
  titleHtml = 'Anuncios, carruseles y <span class="text-gold">la clínica donde grabamos.</span>',
  lead = 'Más material real del caso CEM Valderas. Los textos y las ofertas de cada pieza son de la clínica; así se ve el contenido cuando sale publicado y la clínica donde se graba.',
} = Astro.props;
---
<section id={id} class:list={['pg relative overflow-hidden bg-ink py-16 md:py-24', tone === 'light' && 'section-light']} aria-labelledby={`${id}-title`}>
  <div class="container-x">
    <div class="flex max-w-3xl flex-col gap-4" data-reveal>
      <Eyebrow>Más del trabajo real · {CLIENT.name}</Eyebrow>
      <h2 id={`${id}-title`} class="font-display text-[clamp(2.25rem,5vw,3.6rem)] italic leading-[1.03] text-cream text-balance" set:html={titleHtml} />
      <p class="max-w-2xl text-base leading-relaxed text-muted text-pretty md:text-[17px]">{lead}</p>
    </div>

    <ul class="pg-ads mt-10 md:mt-12" data-reveal-stagger aria-label="Creatividades y carruseles">
      {CEM_ADS.map((p) => (
        <li class="pg-ad">
          <figure class="m-0">
            <div class="pg-frame tone-dark">
              <img src={p.src} alt={p.alt} width={p.width} height={p.height} loading="lazy" decoding="async" />
            </div>
            <figcaption class="mt-3 text-[13px] leading-snug text-muted text-pretty">{p.label}</figcaption>
          </figure>
        </li>
      ))}
    </ul>

    <ul class="pg-clinic mt-12 md:mt-16" data-reveal-stagger aria-label="Fotos de la clínica">
      {CEM_CLINIC.map((p) => (
        <li class="pg-photo tone-dark">
          <img src={p.src} alt={p.alt} width={p.width} height={p.height} loading="lazy" decoding="async" />
          <span class="pg-tag" aria-hidden="true">{p.label}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .pg-ads { display: flex; gap: 14px; list-style: none; margin: 0 -20px; padding: 4px 20px 12px; overflow-x: auto; overscroll-behavior-x: contain; scroll-snap-type: x mandatory; scroll-padding-inline: 20px; scrollbar-width: none; -webkit-overflow-scrolling: touch; }
  .pg-ads::-webkit-scrollbar { display: none; }
  .pg-ad { flex: 0 0 68%; max-width: 300px; scroll-snap-align: start; }
  .pg-frame { overflow: hidden; border-radius: 20px; background: #121212; box-shadow: 0 30px 60px -34px rgb(0 0 0 / 0.8), 0 0 0 1px rgb(255 255 255 / 0.07); }
  .pg-frame img { display: block; width: 100%; height: auto; }
  .section-light .pg-frame { box-shadow: 0 28px 50px -30px rgb(40 26 4 / 0.5), 0 0 0 1px rgb(10 10 10 / 0.06); }

  .pg-clinic { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; list-style: none; margin-inline: 0; padding: 0; }
  .pg-photo { position: relative; overflow: hidden; border-radius: 20px; aspect-ratio: 4 / 5; background: #121212; }
  .pg-photo img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .pg-tag { position: absolute; left: 10px; bottom: 10px; padding: 5px 11px; border-radius: 999px; font-size: 11.5px; font-weight: 500; color: #1a1408; background: linear-gradient(135deg, #f1d9a0, #d9b266 50%, #b8862f); }

  @media (min-width: 768px) {
    .pg-ads { margin: 0; padding: 0; overflow: visible; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 16px; align-items: start; }
    .pg-ad { flex: none; max-width: none; }
    .pg-clinic { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; }
  }
</style>
