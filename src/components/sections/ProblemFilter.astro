---
import Eyebrow from '../ui/Eyebrow.astro';

interface Props { title?: string; lead?: string }
const {
  title = 'No te faltan contactos. Te falta filtro.',
  lead = 'Tu equipo pierde horas contestando a quien solo preguntaba, mientras el que sí estaba listo para comprar se cansa de esperar y elige a otro.',
} = Astro.props;

// 4 se pierden, 3 solo preguntaban, 3 están listos para comprar (ejemplo ilustrativo).
const states = ['lost', 'ask', 'buy', 'lost', 'ask', 'lost', 'buy', 'ask', 'lost', 'buy'] as const;
const legend = [
  { key: 'lost', n: 4, text: 'sin respuesta a tiempo' },
  { key: 'ask', n: 3, text: 'solo preguntaban' },
  { key: 'buy', n: 3, text: 'listos para comprar' },
];
---
<section class="pf relative overflow-hidden bg-ink py-24 md:py-36" data-pf>
  <div class="container-x">
    <div class="grid gap-10 lg:grid-cols-12 lg:gap-12">
      <div class="lg:col-span-7">
        <div data-reveal><Eyebrow>El problema real</Eyebrow></div>
        <h2 data-split class="mt-5 font-display text-[44px] italic leading-[1.02] text-cream text-balance md:text-[80px]">{title}</h2>
      </div>
      <p class="max-w-md self-end text-base leading-relaxed text-muted text-pretty md:text-lg lg:col-span-5 lg:pb-3" data-reveal>{lead}</p>
    </div>

    <figure class="mt-16 md:mt-24">
      <figcaption class="flex items-center justify-between gap-4 text-[11px] uppercase tracking-[0.2em] text-muted">
        <span><span class="text-gold-400">Ejemplo</span> · 10 contactos que te escriben esta semana</span>
      </figcaption>

      <ol class="mt-6 grid max-w-[1000px] grid-cols-5 gap-3 sm:gap-4 md:mt-8 md:grid-cols-10 md:gap-4 lg:gap-6" aria-label="Diez contactos de ejemplo">
        {states.map((s, i) => (
          <li class="pf-dot" data-state={s} style={`--i:${i}`}>
            <span class="pf-ring">
              <svg viewBox="0 0 24 24" class="h-[45%] w-[45%]" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <path d="M12 12a3.75 3.75 0 1 0 0-7.5 3.75 3.75 0 0 0 0 7.5Z M5 20c.8-3.6 3.6-5.5 7-5.5s6.2 1.9 7 5.5" />
              </svg>
            </span>
            <span class="sr-only">{legend.find((l) => l.key === s)!.text}</span>
          </li>
        ))}
      </ol>

      <div class="relative mt-8 h-px w-full bg-white/10" aria-hidden="true">
        <span class="absolute inset-0 origin-left bg-gradient-to-r from-gold-600 via-gold-400 to-gold-200" data-progress-fill></span>
      </div>

      <ul class="mt-8 grid gap-6 sm:grid-cols-3 md:mt-10">
        {legend.map((l) => (
          <li class="pf-legend flex items-baseline gap-4" data-state={l.key}>
            <span class="font-display text-5xl italic leading-none md:text-6xl">{l.n}</span>
            <span class="text-sm leading-snug text-muted">{l.text}</span>
          </li>
        ))}
      </ul>
    </figure>
  </div>
</section>

<style>
  .pf-dot { aspect-ratio: 1; }
  .pf-ring {
    display: flex; height: 100%; width: 100%; align-items: center; justify-content: center; border-radius: 9999px;
    border: 1px solid rgb(255 255 255 / 0.18); background: rgb(255 255 255 / 0.04); color: var(--color-cream);
    transition: opacity 0.9s var(--ease-out-expo), transform 0.9s var(--ease-out-expo), color 0.9s, background 0.9s, border-color 0.9s, box-shadow 0.9s;
    transition-delay: calc(var(--i) * 70ms);
  }
  .pf.is-on [data-state='lost'] .pf-ring { opacity: 0.14; transform: scale(0.82); }
  .pf.is-on [data-state='ask'] .pf-ring { color: var(--color-muted); border-color: rgb(255 255 255 / 0.12); background: rgb(255 255 255 / 0.02); }
  .pf.is-on [data-state='buy'] .pf-ring {
    color: #1a1408; border-color: transparent;
    background: linear-gradient(135deg, var(--color-gold-200), var(--color-gold-400) 45%, var(--color-gold-600));
    box-shadow: 0 0 0 6px rgb(217 178 102 / 0.08), 0 12px 40px -8px rgb(217 178 102 / 0.55);
  }
  .pf-legend { transition: opacity 0.8s var(--ease-out-expo) 0.6s; }
  .pf:not(.is-on) .pf-legend { opacity: 0.35; }
  .pf-legend[data-state='lost'] span:first-child { color: rgb(236 232 225 / 0.3); }
  .pf-legend[data-state='ask'] span:first-child { color: var(--color-muted); }
  .pf-legend[data-state='buy'] span:first-child { color: var(--color-gold-400); }
  @media (max-width: 767px) { .pf-ring { transition-delay: calc(var(--i) * 50ms); } }
</style>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll<HTMLElement>('[data-pf]').forEach((sec) => {
    if (reduce || !('IntersectionObserver' in window)) { sec.classList.add('is-on'); return; }
    const row = sec.querySelector('ol')!;
    const io = new IntersectionObserver(([e]) => {
      if (e.isIntersecting) { sec.classList.add('is-on'); io.disconnect(); }
    }, { rootMargin: '0px 0px -30% 0px', threshold: 0.6 });
    io.observe(row);
  });
</script>
