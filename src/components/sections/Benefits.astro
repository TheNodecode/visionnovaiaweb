---
import SectionHeading from '../ui/SectionHeading.astro';
import Icon from '../ui/Icon.astro';

const items = [
  { icon: 'chat' as const, title: 'La IA habla como tu equipo', text: 'La configuramos con el tono, las frases y las respuestas reales de tu negocio. Nada de mensajes de plantilla.' },
  { icon: 'bolt' as const, title: 'Nunca pierdes el control', text: 'Cuando un cliente necesita a una persona, te llega un aviso al instante y tomas tú la conversación.' },
  { icon: 'chart' as const, title: 'Sabes en qué se va cada euro', text: 'Cada mes, un informe claro: qué hemos hecho, cuánto se ha invertido en Ads y qué ha salido de ahí.' },
];
---
<section class="relative bg-ink py-24 md:py-36" aria-labelledby="benefits-title">
  <div class="container-x">
    <div data-reveal>
      <SectionHeading eyebrow="Siempre incluido" titleHtml='<span id="benefits-title">Tres cosas que <span class="text-gold">no negociamos.</span></span>' />
    </div>
    <ul class="mt-14 grid gap-4 md:mt-20 md:grid-cols-3 md:gap-5" data-reveal-stagger>
      {items.map((b, i) => (
        <li class="glass relative overflow-hidden rounded-[32px] p-7 md:p-9">
          <span class="absolute inset-x-8 top-0 h-px bg-gradient-to-r from-transparent via-gold-400/70 to-transparent" aria-hidden="true"></span>
          <div class="flex items-start justify-between">
            <span class="flex h-12 w-12 items-center justify-center rounded-2xl border border-gold-400/25 bg-gold-400/[0.06] text-gold-200">
              <Icon name={b.icon} size={22} />
            </span>
            <span class="font-display text-5xl italic leading-none text-white/[0.08]" aria-hidden="true">0{i + 1}</span>
          </div>
          <h3 class="mt-10 font-display text-[30px] italic leading-[1.08] text-cream text-balance md:mt-14 md:text-[34px]">{b.title}</h3>
          <p class="mt-4 text-[15px] leading-relaxed text-muted text-pretty">{b.text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
