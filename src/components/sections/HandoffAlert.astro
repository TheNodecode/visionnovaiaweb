---
// Cuándo la IA se aparta y te avisa: lista de situaciones y, al lado, el aviso tal como llega al móvil (simulación).
import Eyebrow from '../ui/Eyebrow.astro';

interface Props {
  id?: string;
  eyebrow?: string;
  titleHtml: string;
  lead: string;
  triggers: string[];
  alert: { title: string; text: string; context: string };
  tone?: 'dark' | 'light';
}
const { id = 'aviso', eyebrow = 'El control es tuyo', titleHtml, lead, triggers, alert, tone = 'light' } = Astro.props;
---
<section id={id} class:list={['ha relative bg-ink py-16 md:py-24', tone === 'light' && 'section-light']} aria-labelledby={`${id}-title`}>
  <div class="container-x grid gap-10 lg:grid-cols-12 lg:items-center lg:gap-16">
    <div class="lg:col-span-7">
      <div class="flex flex-col gap-4" data-reveal>
        <Eyebrow>{eyebrow}</Eyebrow>
        <h2 id={`${id}-title`} class="font-display text-[clamp(2.25rem,6vw,4rem)] italic leading-[1.02] text-cream text-balance" set:html={titleHtml} />
        <p class="max-w-2xl text-base leading-relaxed text-muted text-pretty md:text-lg">{lead}</p>
      </div>
      <ul class="mt-7 grid gap-2.5 sm:grid-cols-2" data-reveal-stagger>
        {triggers.map((t) => (
          <li class="glass flex items-start gap-3 rounded-2xl px-4 py-3.5 text-[14.5px] leading-snug text-cream">
            <svg viewBox="0 0 20 20" class="mt-px h-4 w-4 shrink-0 text-gold-400" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m4.5 10.5 3.5 3.5 7.5-8" /></svg>
            {t}
          </li>
        ))}
      </ul>
    </div>

    <div class="lg:col-span-5" data-reveal>
      <div class="ha-phone tone-dark" role="img" aria-label={`Simulación del aviso en el móvil: ${alert.title}. ${alert.text}`}>
        <p class="text-center font-display text-[56px] italic leading-none text-cream" aria-hidden="true">17:42</p>
        <p class="mt-1 text-center text-[12px] text-muted" aria-hidden="true">martes</p>
        <div class="ha-note mt-8" aria-hidden="true">
          <div class="flex items-center gap-2.5">
            <span class="flex h-7 w-7 items-center justify-center rounded-lg bg-gold text-[10px] font-semibold">N</span>
            <span class="text-[12px] font-medium text-cream/90">CRM Nova</span>
            <span class="ml-auto text-[11px] text-muted">ahora</span>
          </div>
          <p class="mt-2.5 text-[14px] font-medium leading-snug text-cream">{alert.title}</p>
          <p class="mt-1 text-[13px] leading-snug text-cream/80">{alert.text}</p>
          <p class="mt-2.5 rounded-xl bg-white/[0.06] px-3 py-2 text-[12px] leading-snug text-muted">{alert.context}</p>
          <div class="mt-3 grid grid-cols-2 gap-2 text-center text-[12.5px] font-medium">
            <span class="rounded-xl bg-white/10 py-2 text-cream">Ver conversación</span>
            <span class="rounded-xl bg-gold py-2">Tomar el chat</span>
          </div>
        </div>
        <div class="ha-note ha-note-2 mt-2.5" aria-hidden="true"></div>
        <p class="mt-6 text-center text-[10.5px] uppercase tracking-[0.2em] text-muted" aria-hidden="true">Simulación</p>
      </div>
    </div>
  </div>
</section>

<style>
  .ha-phone {
    position: relative; width: min(100%, 340px); margin-inline: auto; padding: 36px 16px 22px; border-radius: 44px;
    border: 8px solid #1a1a1a; background: radial-gradient(120% 70% at 50% 0%, rgb(217 178 102 / 0.18), transparent 60%), #0b0b0b;
    box-shadow: 0 50px 100px -40px rgb(40 26 4 / 0.6), 0 0 0 1px rgb(10 10 10 / 0.08);
  }
  .ha-note { border-radius: 20px; padding: 14px; background: rgb(255 255 255 / 0.08); border: 1px solid rgb(255 255 255 / 0.08); }
  .ha-note-2 { height: 46px; margin-inline: 12px; opacity: 0.45; border-radius: 16px; }
</style>
