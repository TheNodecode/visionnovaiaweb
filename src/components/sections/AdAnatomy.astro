---
// Anuncios reales de un cliente actual (CEM Valderas) y, al lado, por qué están montados así.
// Sin cifras ni resultados del cliente; los precios de sus creatividades son de la clínica.
import Eyebrow from '../ui/Eyebrow.astro';
import Button from '../ui/Button.astro';
import { CLIENT, CLIENT_ADS, CLIENT_REELS } from '../../data/media';
import type { Numbered } from '../../data/blocks';

interface Props {
  id?: string;
  notes: Numbered[];
  eyebrow?: string;
  titleHtml: string;
  lead: string;
  tone?: 'dark' | 'light';
}
const { id = 'anuncios-reales', notes, eyebrow = 'Anuncios reales · Cliente actual', titleHtml, lead, tone = 'light' } = Astro.props;
const pieces = [CLIENT_ADS[0], CLIENT_REELS[0], CLIENT_ADS[1]];
---
<section id={id} class:list={['an relative overflow-hidden bg-ink py-16 md:py-24', tone === 'light' && 'section-light']} aria-labelledby={`${id}-title`}>
  <div class="container-x grid gap-10 lg:grid-cols-12 lg:items-center lg:gap-14">
    <div class="flex flex-col gap-4 lg:col-span-6" data-reveal>
      <Eyebrow>{eyebrow}</Eyebrow>
      <h2 id={`${id}-title`} class="font-display text-[clamp(2.25rem,5.4vw,3.6rem)] italic leading-[1.03] text-cream text-balance" set:html={titleHtml} />
      <p class="flex flex-wrap items-center gap-x-2 gap-y-1 text-[13.5px] text-cream">
        <span class="inline-flex h-7 items-center gap-2 rounded-full border border-white/10 bg-surface px-3 font-medium">
          <span class="h-1.5 w-1.5 rounded-full bg-gold-400" aria-hidden="true"></span>{CLIENT.name}
        </span>
        <span class="text-muted">{CLIENT.sector} · @{CLIENT.instagram}</span>
      </p>
      <p class="max-w-xl text-base leading-relaxed text-muted text-pretty md:text-[17px]">{lead}</p>
      <ol class="mt-2 flex flex-col">
        {notes.map((n, i) => (
          <li class="an-note">
            <span class="w-6 shrink-0 font-display text-[22px] italic leading-none text-gold-400" aria-hidden="true">{i + 1}</span>
            <div>
              <h3 class="text-[16px] font-medium leading-snug text-cream">{n.title}</h3>
              <p class="mt-1 text-[14.5px] leading-relaxed text-muted text-pretty">{n.text}</p>
            </div>
          </li>
        ))}
      </ol>
      <div class="mt-2 flex flex-col gap-3 sm:flex-row sm:items-center sm:gap-5">
        <Button data-open-form size="lg" class="w-full whitespace-nowrap sm:w-auto">
          Quiero anuncios así
          <svg viewBox="0 0 16 16" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" /></svg>
        </Button>
        <span class="text-center text-[13px] text-muted sm:text-left">Llamada de 20 minutos · sin compromiso</span>
      </div>
    </div>

    <figure class="m-0 lg:col-span-6" aria-label={`Anuncios y vídeos reales de ${CLIENT.name}`}>
      <ul class="an-board">
        {pieces.map((p, i) => (
          <li class={`an-piece an-piece-${i}`}>
            <div class="an-phone tone-dark">
              <img src={p.src} alt={p.alt} width={p.width} height={p.height} loading="lazy" decoding="async" />
            </div>
            <p class="mt-2.5 text-center text-[12.5px] leading-tight text-muted">{p.label}</p>
          </li>
        ))}
      </ul>
      <figcaption class="mt-4 text-center text-[12.5px] leading-relaxed text-muted text-pretty">Capturas tal y como salen en Instagram. Los precios que aparecen son de la clínica, y sus resultados son suyos: no publicamos cifras de clientes.</figcaption>
    </figure>
  </div>
</section>

<style>
  .an-note { display: flex; gap: 16px; padding: 14px 0; border-top: 1px solid rgb(10 10 10 / 0.1); }
  .an:not(.section-light) .an-note { border-top-color: rgb(255 255 255 / 0.1); }
  .an-note:first-child { border-top: 0; }
  .an-board { display: flex; justify-content: center; gap: 12px; list-style: none; margin: 0; padding: 0; }
  .an-piece { flex: 1 1 0; max-width: 176px; min-width: 0; }
  .an-piece-1 { margin-top: 36px; }
  .an-phone { position: relative; overflow: hidden; aspect-ratio: 9 / 18.5; border-radius: 22px; border: 5px solid #161616; background: #121212;
    box-shadow: 0 26px 50px -26px rgb(40 26 4 / 0.55), 0 0 0 1px rgb(10 10 10 / 0.06); }
  .an-phone img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: top; }
  @media (min-width: 1024px) { .an-board { gap: 18px; } .an-piece-1 { margin-top: 64px; } .an-phone { border-radius: 26px; border-width: 6px; } }
</style>
