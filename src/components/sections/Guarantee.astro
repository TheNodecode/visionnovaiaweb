---
import Icon from '../ui/Icon.astro';
import Button from '../ui/Button.astro';

interface Props { tone?: 'dark' | 'light' }
const { tone = 'dark' } = Astro.props;
---
<section class:list={['relative isolate overflow-hidden bg-ink py-14 md:py-20', tone === 'light' && 'section-light']} aria-labelledby="guarantee-title">
  <div class="pointer-events-none absolute left-1/2 top-1/2 -z-10 h-[520px] w-[900px] max-w-[160vw] -translate-x-1/2 -translate-y-1/2 rounded-full bg-[radial-gradient(closest-side,rgb(217_178_102/0.11),transparent)]" aria-hidden="true"></div>
  <div class="container-x">
    <div class="relative mx-auto grid max-w-6xl overflow-hidden rounded-[32px] border border-gold-400/25 bg-[linear-gradient(135deg,rgb(217_178_102/0.09),rgb(18_18_18/0.7)_55%)] md:grid-cols-[1.55fr_1fr]" data-reveal>
      <span class="absolute inset-x-12 top-0 h-px bg-gradient-to-r from-transparent via-gold-200/70 to-transparent" aria-hidden="true"></span>

      <div class="flex flex-col gap-5 p-7 sm:p-9 md:flex-row md:gap-7 md:p-11">
        <span class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl border border-gold-400/40 bg-gold-400/10 text-gold-200 shadow-[0_0_50px_-12px_rgb(217_178_102/0.6)]">
          <Icon name="shield" size={28} />
        </span>
        <div>
          <h2 id="guarantee-title" class="text-[11px] font-medium uppercase tracking-[0.3em] text-gold-400">Nuestra garantía</h2>
          <p class="mt-3 font-display text-[28px] italic leading-[1.12] text-cream text-balance md:text-[36px] xl:text-[40px]">
            Si en 30 días el sistema no te entrega al menos 15 clientes filtrados, <span class="text-gold">el segundo mes va por nuestra cuenta.</span>
          </p>
        </div>
      </div>

      <div class="flex flex-col justify-center gap-5 border-t border-white/10 bg-white/[0.02] p-7 sm:p-9 md:border-l md:border-t-0 md:p-10">
        <p class="flex items-baseline gap-3">
          <span class="font-display text-[56px] italic leading-none text-gold-200">3</span>
          <span class="text-[11px] font-medium uppercase tracking-[0.24em] text-cream/80">plazas al mes</span>
        </p>
        <p class="text-[15px] leading-relaxed text-muted text-pretty">Solo incorporamos 3 negocios nuevos al mes, porque cada implantación la montamos a mano.</p>
        <Button data-open-form class="w-full sm:w-auto sm:self-start">
          Reservar mi plaza
          <svg viewBox="0 0 16 16" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" /></svg>
        </Button>
      </div>
    </div>
  </div>
</section>
