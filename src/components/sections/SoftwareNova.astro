---
import { SITE } from '../../config/site';

// compact: banda pequeña (en la home va al final, en hoja clara pegada a las FAQ para no trocear el ritmo).
interface Props { tone?: 'dark' | 'light'; compact?: boolean }
const { tone = 'dark', compact = false } = Astro.props;
---
<section class:list={['relative bg-ink', compact ? 'pb-14 pt-2 md:pb-20' : 'py-16 md:py-24', tone === 'light' && 'section-light']} aria-labelledby="software-title">
  <div class="container-x">
    <div class:list={['glass relative flex flex-col overflow-hidden md:flex-row md:items-center md:justify-between', compact ? 'gap-5 rounded-[24px] p-5 sm:p-7 md:gap-10' : 'gap-8 rounded-[32px] p-7 sm:p-10 md:gap-12 md:p-12']} data-reveal>
      <div class="pointer-events-none absolute -left-20 -top-24 h-64 w-64 rounded-full bg-[radial-gradient(closest-side,rgb(217_178_102/0.14),transparent)]" aria-hidden="true"></div>
      <div class="relative flex items-start gap-5 md:gap-7">
        <img src="/brand/logo-star-plate.png" alt="" width="56" height="56" class="h-12 w-12 shrink-0 rounded-[14px] ring-1 ring-gold-400/30 md:h-14 md:w-14" loading="lazy" decoding="async" />
        <div>
          <h2 id="software-title" class:list={['font-display italic leading-[1.05] text-cream', compact ? 'text-[26px] md:text-[32px]' : 'text-[30px] md:text-[40px]']}>¿Solo quieres el software?</h2>
          <p class="mt-3 max-w-xl text-[15px] leading-relaxed text-muted text-pretty md:text-base">Nova es nuestro CRM con IA y WhatsApp. Si prefieres montarlo tú, tienes planes desde la app.</p>
        </div>
      </div>
      <a href={SITE.appUrl} rel="noopener" class="relative inline-flex min-h-12 shrink-0 items-center justify-center gap-2 rounded-full border border-gold-400/40 px-7 text-[13px] font-medium text-gold-200 transition duration-300 ease-out-expo hover:bg-gold-400/10 active:scale-[0.97]">
        Ver planes de Nova
        <svg viewBox="0 0 16 16" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M5 11 11 5M6 5h5v5" /></svg>
      </a>
    </div>
  </div>
</section>
