---
import SectionHeading from '../ui/SectionHeading.astro';

interface Props { items: { src?: string; poster: string; label: string }[] }
const { items } = Astro.props;
// Encuadres distintos del mismo póster mientras no haya vídeos reales.
const framing = ['object-[30%_60%]', 'object-[60%_70%]', 'object-[50%_40%]', 'object-[70%_50%]', 'object-[40%_80%]'];
---
<section class="relative overflow-hidden bg-ink py-24 md:py-36" aria-labelledby="cw-title">
  <div class="pointer-events-none absolute left-1/2 top-1/2 h-[520px] w-[900px] max-w-full -translate-x-1/2 -translate-y-1/2 bg-[radial-gradient(closest-side,rgb(217_178_102/0.10),transparent)]" aria-hidden="true"></div>
  <div class="container-x relative">
    <div data-reveal>
      <SectionHeading eyebrow="Contenido real" titleHtml='<span id="cw-title">Contenido que parece tuyo <span class="text-gold">porque lo es.</span></span>'
        lead="Nada de vídeos de stock ni avatares: grabamos a tu equipo, tu local y tu forma de explicar lo que haces." />
    </div>
  </div>

  <ul class="cw-rail relative mt-14 md:mt-20" aria-label="Ejemplos de piezas de contenido">
    {items.map((it, i) => (
      <li class="cw-item" data-parallax={i % 2 === 0 ? '0.1' : '-0.1'}>
        <div class="cw-phone relative aspect-[9/19] overflow-hidden rounded-[44px] border-[10px] border-surface-2 bg-surface shadow-[0_50px_100px_-40px_rgb(0_0_0/1),0_0_0_1px_rgb(255_255_255/0.06)]">
          {it.src
            ? <video data-inview-video class={`absolute inset-0 h-full w-full object-cover ${framing[i % framing.length]}`} src={it.src} poster={it.poster} muted loop playsinline preload="none" aria-label={it.label}></video>
            : <img class={`absolute inset-0 h-full w-full scale-150 object-cover ${framing[i % framing.length]}`} src={it.poster} alt="" loading="lazy" decoding="async" />}
          <div class="pointer-events-none absolute inset-0 bg-gradient-to-b from-black/40 via-transparent to-black/70" aria-hidden="true"></div>
          <span class="absolute left-1/2 top-2.5 h-[22px] w-[34%] -translate-x-1/2 rounded-full bg-black" aria-hidden="true"></span>
          <div class="absolute inset-x-4 top-11 flex gap-1" aria-hidden="true">
            <span class="h-0.5 flex-1 rounded-full bg-white/80"></span><span class="h-0.5 flex-1 rounded-full bg-white/30"></span><span class="h-0.5 flex-1 rounded-full bg-white/30"></span>
          </div>
          <div class="absolute inset-x-4 bottom-5" aria-hidden="true">
            <div class="flex items-center gap-2">
              <span class="h-6 w-6 rounded-full bg-gold"></span>
              <span class="text-[11px] font-medium text-white/90">tunegocio</span>
            </div>
            <p class="mt-2 text-[12px] leading-snug text-white/85">{it.label}</p>
          </div>
        </div>
        <p class="mt-5 text-center font-display text-xl italic text-cream/90">{it.label}</p>
      </li>
    ))}
  </ul>
</section>

<script>import '../../scripts/inview-video.ts';</script>

<style>
  /* Móvil: carrusel con snap; el desbordamiento vive en el propio carrusel */
  .cw-rail {
    display: flex; gap: 16px; overflow-x: auto; overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory; scroll-padding-inline: 20px; padding: 8px 20px 24px;
    scrollbar-width: none; -webkit-overflow-scrolling: touch;
  }
  .cw-rail::-webkit-scrollbar { display: none; }
  .cw-item { flex: 0 0 68%; max-width: 280px; scroll-snap-align: start; }
  @media (min-width: 768px) {
    .cw-rail { overflow: visible; justify-content: center; gap: clamp(24px, 4vw, 56px); padding: 40px 32px; max-width: 1240px; margin-inline: auto; }
    .cw-item { flex: 0 1 280px; }
    .cw-item:nth-child(even) { margin-top: 80px; }
  }
</style>
