---
// «Qué pasa cuando reservas»: tres pasos justo antes del formulario, para que nadie reserve a ciegas.
// Sin plazos prometidos para la propuesta.
import Eyebrow from '../ui/Eyebrow.astro';
import { AFTER_BOOKING, type Step } from '../../data/offer';

interface Props { id?: string; steps?: Step[]; titleHtml?: string; tone?: 'dark' | 'light' }
const {
  id = 'al-reservar',
  steps = AFTER_BOOKING,
  titleHtml = 'Qué pasa <span class="text-gold">cuando reservas.</span>',
  tone = 'dark',
} = Astro.props;
---
<section id={id} class:list={['relative bg-ink pb-2 pt-16 md:pt-24', tone === 'light' && 'section-light pb-16 md:pb-24']} aria-labelledby={`${id}-title`}>
  <div class="container-x">
    <div class="flex flex-col items-center gap-4 text-center" data-reveal>
      <Eyebrow>Sin sorpresas</Eyebrow>
      <h2 id={`${id}-title`} class="font-display text-[clamp(2.25rem,6vw,4rem)] italic leading-[1.02] text-cream text-balance" set:html={titleHtml} />
    </div>
    <ol class="ab-list mt-8 grid gap-3 md:mt-12 md:grid-cols-3 md:gap-4" data-reveal-stagger>
      {steps.map((s, i) => (
        <li class="ab-step glass relative rounded-[24px] p-5 md:p-7">
          <div class="flex items-center gap-3">
            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-gold-400/50 bg-gold-400/10 font-display text-[18px] italic text-gold-200" aria-hidden="true">{i + 1}</span>
            <h3 class="text-[16.5px] font-medium leading-snug text-cream">{s.title}</h3>
          </div>
          <p class="mt-3 text-[14.5px] leading-relaxed text-muted text-pretty">{s.text}</p>
          {i < steps.length - 1 && (
            <span class="ab-arrow" aria-hidden="true">
              <svg viewBox="0 0 16 16" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3 8h10M9 4l4 4-4 4" /></svg>
            </span>
          )}
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .ab-arrow {
    position: absolute; z-index: 1; left: 50%; bottom: -19px; translate: -50% 0; rotate: 90deg;
    display: flex; width: 26px; height: 26px; align-items: center; justify-content: center; border-radius: 999px;
    background: var(--color-ink); border: 1px solid rgb(217 178 102 / 0.4); color: #d9b266;
  }
  @media (min-width: 768px) {
    .ab-arrow { left: auto; right: -21px; bottom: auto; top: 50%; translate: 0 -50%; rotate: 0deg; }
  }
</style>
