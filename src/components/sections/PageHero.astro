---
import Button from '../ui/Button.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import type { ClientPiece } from '../../data/media';

interface Props { eyebrow: string; title: string; titleAccent?: string; lead: string; ctaLabel?: string; bullets?: string[];
  /** Pieza real del cliente en un móvil (solo el cartel: no pesa en el LCP). */
  visual?: ClientPiece }
const { eyebrow, title, titleAccent, lead, ctaLabel = 'Ver si mi negocio encaja', bullets = [], visual } = Astro.props;
---
<section class="relative isolate overflow-hidden bg-ink grain" aria-labelledby="page-title">
  <div class="starfield -z-10 opacity-60" aria-hidden="true"></div>
  <div class="pointer-events-none absolute -right-[20%] -top-[30%] -z-10 h-[620px] w-[620px] rounded-full bg-[radial-gradient(closest-side,rgb(217_178_102/0.18),transparent)] md:-right-[5%] md:h-[820px] md:w-[820px]" aria-hidden="true"></div>
  <div class="pointer-events-none absolute inset-x-0 bottom-0 -z-10 h-32 bg-gradient-to-b from-transparent to-ink" aria-hidden="true"></div>

  <div class="container-x relative pb-16 pt-[calc(env(safe-area-inset-top)+150px)] md:pb-24 md:pt-48">
    <div class:list={['max-w-4xl', visual && 'lg:max-w-[60%]']}>
      <div data-intro><Eyebrow>{eyebrow}</Eyebrow></div>
      <h1 id="page-title" data-intro style="--intro-delay: 80ms" class="mt-5 font-display text-[42px] italic leading-[1.03] text-cream text-balance md:mt-7 md:text-[76px]">
        {title}{titleAccent && <> <span class="text-gold">{titleAccent}</span></>}
      </h1>
      <p class="mt-6 max-w-2xl text-base leading-relaxed text-muted text-pretty md:mt-8 md:text-lg" data-intro style="--intro-delay: 200ms">{lead}</p>

      <div class="mt-9 flex flex-col gap-8 md:mt-11 md:flex-row md:items-center md:gap-10" data-intro style="--intro-delay: 280ms">
        <Button size="lg" data-open-form data-magnetic class="w-full md:w-auto">{ctaLabel}</Button>
        {bullets.length > 0 && (
          <ul class="flex flex-col gap-2.5 text-sm text-cream/80 md:gap-2">
            {bullets.map((b) => (
              <li class="flex items-start gap-2.5">
                <svg viewBox="0 0 16 16" class="mt-[3px] h-3.5 w-3.5 shrink-0 text-gold-400" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="m3 8.5 3 3 7-7" /></svg>
                {b}
              </li>
            ))}
          </ul>
        )}
      </div>
    </div>
    {visual && (
      <figure class="ph-visual" data-intro style="--intro-delay: 360ms">
        <div class="ph-phone">
          <img src={visual.src} alt={visual.alt} width={visual.width} height={visual.height} loading="lazy" decoding="async" fetchpriority="low" />
        </div>
        <figcaption class="ph-cap">{visual.label}</figcaption>
      </figure>
    )}
  </div>
</section>

<style>
  .ph-visual { margin: 40px 0 0; display: flex; flex-direction: column; align-items: center; gap: 14px; }
  .ph-phone { width: 190px; aspect-ratio: 9 / 18.5; overflow: hidden; border-radius: 30px; border: 6px solid #1f1f1f; background: #121212; transform: rotate(3deg); box-shadow: 0 40px 80px -30px rgb(0 0 0 / 0.9), 0 0 0 1px rgb(255 255 255 / 0.08), 0 0 80px -20px rgb(217 178 102 / 0.25); }
  .ph-phone img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: top; }
  .ph-cap { max-width: 24ch; text-align: center; font-size: 12.5px; line-height: 1.35; color: var(--color-muted); }
  @media (min-width: 1024px) {
    .ph-visual { position: absolute; right: 2%; top: 50%; margin: 0; transform: translateY(-44%); }
    .ph-phone { width: 250px; transform: rotate(4deg); }
  }
  @media (prefers-reduced-motion: reduce) { .ph-phone { transform: none; } }
</style>
