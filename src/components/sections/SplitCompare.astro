---
// Dos columnas enfrentadas: «dos frentes» (compradores / propietarios) o «quién responde qué»
// (lo que contesta la IA / lo que pasa a la profesional). Datos en sector-sales.ts.
import Eyebrow from '../ui/Eyebrow.astro';
import Icon from '../ui/Icon.astro';
import type { SplitColumn } from '../../data/blocks';

interface Props {
  id?: string;
  eyebrow: string;
  titleHtml: string;
  lead: string;
  columns: [SplitColumn, SplitColumn];
  /** Palabra del separador central («y», «o», «→»…). */
  joiner?: string;
  note?: string;
  tone?: 'dark' | 'light';
}
const { id = 'frentes', eyebrow, titleHtml, lead, columns, joiner = 'y', note, tone = 'light' } = Astro.props;
---
<section id={id} class:list={['sc relative bg-ink py-16 md:py-24', tone === 'light' && 'section-light']} aria-labelledby={`${id}-title`}>
  <div class="container-x">
    <div class="mx-auto flex max-w-3xl flex-col items-center gap-4 text-center" data-reveal>
      <Eyebrow>{eyebrow}</Eyebrow>
      <h2 id={`${id}-title`} class="font-display text-[clamp(2.25rem,6vw,4rem)] italic leading-[1.02] text-cream text-balance" set:html={titleHtml} />
      <p class="max-w-2xl text-base leading-relaxed text-muted text-pretty md:text-lg">{lead}</p>
    </div>

    <div class="sc-grid mt-8 md:mt-12" data-reveal-stagger>
      {columns.map((c, i) => (
        <article class:list={['sc-col rounded-[28px] p-5 md:p-7', i === 0 ? 'glass' : 'sc-dark tone-dark']} aria-labelledby={`${id}-c${i}`}>
          <div class="flex items-center gap-3">
            <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-2xl border border-gold-400/40 bg-gold-400/10 text-gold-200" aria-hidden="true"><Icon name={c.icon} size={20} /></span>
            <p class="text-[11px] font-medium uppercase tracking-[0.24em] text-gold-400">{c.label}</p>
          </div>
          <h3 id={`${id}-c${i}`} class="mt-5 font-display text-[28px] italic leading-[1.08] text-cream text-balance md:text-[32px]">{c.title}</h3>
          <p class="mt-2.5 text-[15px] leading-relaxed text-muted text-pretty">{c.text}</p>
          <ul class="mt-5 flex flex-col">
            {c.items.map((it) => (
              <li class="sc-item flex gap-3 text-[14.5px] leading-snug text-cream">
                <svg viewBox="0 0 20 20" class="mt-px h-4 w-4 shrink-0 text-gold-400" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m4.5 10.5 3.5 3.5 7.5-8" /></svg>{it}
              </li>
            ))}
          </ul>
        </article>
      ))}
      <span class="sc-join" aria-hidden="true">{joiner}</span>
    </div>
    {note && <p class="mx-auto mt-6 max-w-2xl text-center text-[13px] leading-relaxed text-muted text-pretty" data-reveal>{note}</p>}
  </div>
</section>

<style>
  .sc-grid { position: relative; display: grid; gap: 14px; }
  .sc-dark { background: radial-gradient(120% 60% at 100% 0%, rgb(217 178 102 / 0.14), transparent 60%), #0d0d0d; border: 1px solid rgb(217 178 102 / 0.26); color: var(--color-cream); }
  .sc-item { padding: 11px 0; border-top: 1px solid rgb(255 255 255 / 0.08); }
  .section-light .glass .sc-item { border-top-color: rgb(10 10 10 / 0.08); }
  .sc-join {
    position: absolute; left: 50%; top: 50%; translate: -50% -50%; display: none; width: 52px; height: 52px; align-items: center; justify-content: center;
    border-radius: 999px; background: var(--color-ink); border: 1px solid rgb(184 134 47 / 0.5);
    font-family: var(--font-display, serif); font-style: italic; font-size: 22px; color: var(--color-gold-400);
  }
  @media (min-width: 900px) {
    .sc-grid { grid-template-columns: 1fr 1fr; gap: 20px; }
    .sc-join { display: flex; }
  }
</style>
