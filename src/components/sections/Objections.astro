---
// Objeciones duras con respuesta directa: primero la frase que se lee de un vistazo, luego el porqué.
// Las páginas de sector pasan sus propias `items`. Cierra con un CTA al formulario.
import Eyebrow from '../ui/Eyebrow.astro';
import Button from '../ui/Button.astro';
import { OBJECTIONS, type Objection } from '../../data/offer';

interface Props {
  id?: string;
  items?: Objection[];
  eyebrow?: string;
  titleHtml?: string;
  lead?: string;
  tone?: 'dark' | 'light';
  cta?: string | false;
}
const {
  id = 'objeciones',
  items = OBJECTIONS,
  eyebrow = 'Sin rodeos',
  titleHtml = 'Lo que estás pensando, <span class="text-gold">respondido.</span>',
  lead = 'Las dudas que tendríamos nosotros en tu lugar. Mejor resolverlas aquí que en letra pequeña.',
  tone = 'light',
  cta = 'Ver si mi negocio encaja',
} = Astro.props;
---
<section id={id} class:list={['relative bg-ink py-16 md:py-24', tone === 'light' && 'section-light']} aria-labelledby={`${id}-title`}>
  <div class="container-x">
    <div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] lg:items-end lg:gap-16" data-reveal>
      <div class="flex flex-col gap-4">
        <Eyebrow>{eyebrow}</Eyebrow>
        <h2 id={`${id}-title`} class="font-display text-[clamp(2.25rem,6vw,4rem)] italic leading-[1.02] text-cream text-balance" set:html={titleHtml} />
      </div>
      <p class="max-w-xl text-base leading-relaxed text-muted text-pretty md:text-lg">{lead}</p>
    </div>

    <ul class="mt-8 grid gap-3 md:mt-12 md:grid-cols-2 md:gap-4 xl:grid-cols-3" data-reveal-stagger>
      {items.map((o) => (
        <li class="glass flex flex-col rounded-[24px] p-5 md:p-7">
          <h3 class="font-display text-[26px] italic leading-[1.08] text-cream text-balance md:text-[29px]">«{o.q}»</h3>
          <p class="mt-3 text-[15.5px] font-medium leading-snug text-cream text-pretty">{o.short}</p>
          <p class="mt-2 text-[14.5px] leading-relaxed text-muted text-pretty">{o.a}</p>
        </li>
      ))}
    </ul>

    {cta && (
      <div class="tone-dark mt-4 flex flex-col items-start gap-4 rounded-[24px] bg-ink p-6 sm:flex-row sm:items-center sm:justify-between md:p-7" data-reveal>
        <div>
          <p class="font-display text-[26px] italic leading-tight text-cream md:text-[30px]">¿Tu caso no está aquí? <span class="text-gold">Lo vemos en 20 minutos.</span></p>
          <p class="mt-1.5 text-[14px] text-muted">Una llamada, tu caso concreto y una respuesta clara: encaja o no encaja.</p>
        </div>
        <Button data-open-form size="lg" class="w-full shrink-0 sm:w-auto">
          {cta}
          <svg viewBox="0 0 16 16" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" /></svg>
        </Button>
      </div>
    )}
  </div>
</section>
