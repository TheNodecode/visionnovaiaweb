---
import Eyebrow from '../ui/Eyebrow.astro';

interface Props { title: string; steps: { title: string; text: string }[] }
const { title, steps } = Astro.props;
---
<section class="relative bg-ink py-24 md:py-32">
  <div class="container-x grid gap-12 lg:grid-cols-12 lg:gap-16">
    <div class="lg:col-span-5">
      <div class="lg:sticky lg:top-36">
        <div data-reveal><Eyebrow>Paso a paso</Eyebrow></div>
        <h2 data-split class="mt-5 font-display text-[40px] italic leading-[1.04] text-cream text-balance md:text-[60px]">{title}</h2>
      </div>
    </div>
    <ol class="relative lg:col-span-7">
      <span class="absolute bottom-6 left-[19px] top-6 w-px bg-white/10 md:left-[23px]" aria-hidden="true">
        <span class="absolute inset-0 origin-top bg-gradient-to-b from-gold-200 via-gold-400 to-gold-600" data-progress-fill="y"></span>
      </span>
      {steps.map((s, i) => (
        <li class="relative flex gap-6 pb-12 last:pb-0 md:gap-8 md:pb-16" data-reveal>
          <span class="relative z-10 flex h-10 w-10 shrink-0 items-center justify-center rounded-full border border-gold-400/40 bg-ink font-display text-lg italic text-gold-200 md:h-12 md:w-12 md:text-xl">{i + 1}</span>
          <div class="pt-1.5 md:pt-2.5">
            <h3 class="font-display text-[26px] italic leading-[1.1] text-cream md:text-[32px]">{s.title}</h3>
            <p class="mt-3 max-w-lg text-[15px] leading-relaxed text-muted text-pretty md:text-base">{s.text}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
