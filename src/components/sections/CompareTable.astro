---
// Tabla comparativa accesible (p. ej. app de WhatsApp Business frente a la API oficial).
// En móvil la tabla se desplaza dentro de su propio marco; la página nunca se desborda.
import Eyebrow from '../ui/Eyebrow.astro';
import type { CompareRow } from '../../data/blocks';

interface Props {
  id?: string;
  rows: CompareRow[];
  columns: [string, string];
  caption: string;
  eyebrow?: string;
  titleHtml: string;
  lead: string;
  note?: string;
  tone?: 'dark' | 'light';
}
const { id = 'comparativa', rows, columns, caption, eyebrow = 'Comparativa', titleHtml, lead, note, tone = 'light' } = Astro.props;
---
<section id={id} class:list={['ct relative bg-ink py-16 md:py-24', tone === 'light' && 'section-light']} aria-labelledby={`${id}-title`}>
  <div class="container-x">
    <div class="grid gap-4 lg:grid-cols-2 lg:items-end lg:gap-16" data-reveal>
      <div class="flex flex-col gap-4">
        <Eyebrow>{eyebrow}</Eyebrow>
        <h2 id={`${id}-title`} class="font-display text-[clamp(2.25rem,6vw,4rem)] italic leading-[1.02] text-cream text-balance" set:html={titleHtml} />
      </div>
      <p class="max-w-xl text-base leading-relaxed text-muted text-pretty md:text-lg">{lead}</p>
    </div>

    <div class="ct-scroll glass mt-8 rounded-[28px] md:mt-12" role="region" aria-labelledby={`${id}-caption`} tabindex="0" data-reveal>
      <table class="ct-table">
        <caption id={`${id}-caption`} class="sr-only">{caption}</caption>
        <thead>
          <tr>
            <th scope="col"><span class="sr-only">Qué comparamos</span></th>
            <th scope="col">{columns[0]}</th>
            <th scope="col" class="ct-hi">{columns[1]}</th>
          </tr>
        </thead>
        <tbody>
          {rows.map((r) => (
            <tr>
              <th scope="row">{r.feature}</th>
              <td>{r.a}</td>
              <td class="ct-hi">{r.b}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="mt-3 text-[12.5px] text-muted md:hidden" aria-hidden="true">Desliza la tabla hacia los lados para verla entera →</p>
    {note && <p class="mt-5 max-w-3xl text-[13px] leading-relaxed text-muted text-pretty" data-reveal>{note}</p>}
  </div>
</section>

<style>
  .ct-scroll { overflow-x: auto; overscroll-behavior-x: contain; -webkit-overflow-scrolling: touch; }
  .ct-scroll:focus-visible { outline: 2px solid var(--color-gold-400); outline-offset: 3px; }
  .ct-table { width: 100%; min-width: 640px; border-collapse: collapse; text-align: left; font-size: 14.5px; line-height: 1.5; }
  .ct-table th, .ct-table td { padding: 16px 18px; vertical-align: top; border-top: 1px solid rgb(255 255 255 / 0.08); }
  .section-light .ct-table th, .section-light .ct-table td { border-top-color: rgb(10 10 10 / 0.08); }
  .ct-table thead th { border-top: 0; padding-top: 20px; font-size: 11px; font-weight: 500; text-transform: uppercase; letter-spacing: 0.18em; color: var(--color-muted); }
  .ct-table thead th.ct-hi { color: var(--color-gold-400); }
  .ct-table tbody th { width: 26%; font-weight: 500; color: var(--color-cream); }
  .ct-table td { width: 37%; color: var(--color-muted); text-wrap: pretty; }
  .ct-table td.ct-hi { color: var(--color-cream); }
  .ct-hi { background: rgb(217 178 102 / 0.07); }
  .section-light .ct-hi { background: rgb(184 134 47 / 0.08); }
  @media (min-width: 768px) { .ct-table th, .ct-table td { padding: 18px 26px; } .ct-table { font-size: 15px; } }
</style>
