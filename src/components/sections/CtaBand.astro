---
import Button from '../ui/Button.astro';

interface Props { title: string; lead?: string }
const { title, lead } = Astro.props;
---
<section class="relative isolate overflow-hidden bg-ink py-20 md:py-32">
  <div class="starfield -z-10 opacity-50" aria-hidden="true"></div>
  <div class="pointer-events-none absolute left-1/2 top-1/2 -z-10 h-[520px] w-[1100px] max-w-[200vw] -translate-x-1/2 -translate-y-1/2 bg-[radial-gradient(closest-side,rgb(217_178_102/0.22),rgb(217_178_102/0.05)_55%,transparent)]" aria-hidden="true"></div>
  <span class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-white/10 to-transparent" aria-hidden="true"></span>
  <div class="container-x flex flex-col items-center text-center">
    <h2 data-split class="max-w-5xl font-display text-[48px] italic leading-[0.98] text-cream text-balance md:text-[104px]">{title}</h2>
    {lead && <p class="mt-7 max-w-xl text-base leading-relaxed text-muted text-pretty md:text-lg" data-reveal>{lead}</p>}
    <div class="mt-10 w-full sm:w-auto md:mt-12" data-reveal>
      <Button data-open-form data-magnetic size="lg" class="w-full sm:w-auto">
        Ver si mi negocio encaja
        <svg viewBox="0 0 16 16" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" /></svg>
      </Button>
    </div>
    <p class="mt-5 text-xs text-muted/80" data-reveal>Llamada de 20 minutos · sin compromiso</p>
  </div>
</section>
