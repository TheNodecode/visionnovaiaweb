---
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import { SITE } from '../../config/site';

const seals = [
  { icon: 'shield' as const, text: SITE.metaPartner ? 'Meta Tech Provider' : 'WhatsApp Business API oficial' },
  { icon: 'globe' as const, text: 'Grabamos en toda España' },
  { icon: 'calendar' as const, text: '3 plazas al mes' },
];
---
<section class="hero relative isolate flex min-h-[100svh] items-center overflow-hidden bg-ink" aria-labelledby="hero-title">
  <video data-hero-video class="absolute inset-0 -z-20 h-full w-full object-cover opacity-60" muted loop playsinline preload="none"
    poster="/video/hero-poster.jpg" src="/video/hero.mp4" aria-hidden="true" tabindex="-1"></video>
  <div class="starfield -z-10" aria-hidden="true"></div>
  <!-- velo para que el texto respire sobre la burbuja, y fundido a ink abajo -->
  <div class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(60%_50%_at_50%_45%,rgb(10_10_10/0.55),transparent_75%)]" aria-hidden="true"></div>
  <div class="pointer-events-none absolute inset-x-0 bottom-0 -z-10 h-[45%] bg-gradient-to-b from-transparent via-ink/70 to-ink" aria-hidden="true"></div>
  <div class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-40 bg-gradient-to-b from-ink/80 to-transparent" aria-hidden="true"></div>

  <div class="container-x relative flex flex-col items-center pb-24 pt-[calc(env(safe-area-inset-top)+128px)] text-center md:pb-28 md:pt-36">
    <p class="glass inline-flex min-h-9 items-center gap-2.5 whitespace-nowrap rounded-full px-4 text-[10px] font-medium uppercase tracking-[0.08em] text-cream/85 min-[400px]:tracking-[0.14em] sm:text-xs sm:tracking-[0.18em]" data-intro>
      <span class="relative flex h-2 w-2" aria-hidden="true">
        <span class="hero-ping absolute inset-0 rounded-full bg-gold-400"></span>
        <span class="relative h-2 w-2 rounded-full bg-gold-400"></span>
      </span>
      Agencia de contenido y captación con IA
    </p>

    <h1 id="hero-title" data-intro style="--intro-delay: 80ms" class="text-silver mt-7 max-w-[11em] font-display text-[44px] italic leading-[1.02] tracking-[-0.01em] text-balance md:mt-8 md:max-w-[14em] md:text-[88px]">
      Grabamos tu negocio. Lo llenamos de clientes.
      <span class="text-gold mt-1 block md:mt-2">La IA te deja solo los que van a comprar.</span>
    </h1>

    <p class="mt-6 max-w-xl text-[15px] leading-relaxed text-cream/75 text-pretty md:mt-8 md:text-lg" data-intro style="--intro-delay: 200ms">
      Contenido, Meta Ads y un CRM con IA que filtra cada contacto. Para negocios de ticket alto, en toda España.
    </p>

    <div class="mt-9 flex w-full flex-col gap-3 sm:w-auto sm:flex-row sm:justify-center md:mt-11" data-intro style="--intro-delay: 280ms">
      <Button size="lg" data-open-form data-magnetic class="w-full sm:w-auto">
        Ver si mi negocio encaja
        <svg viewBox="0 0 16 16" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" /></svg>
      </Button>
      <Button size="lg" variant="glass" href="#sistema" class="w-full sm:w-auto">Ver cómo trabajamos</Button>
    </div>

    <ul class="mt-10 flex flex-wrap items-center justify-center gap-x-6 gap-y-3 text-[12px] tracking-wide text-muted md:mt-14 md:text-[13px]" data-intro style="--intro-delay: 360ms">
      {seals.map((s, i) => (
        <li class="flex items-center gap-2">
          {i > 0 && <span class="mr-4 hidden h-3 w-px bg-white/15 sm:block" aria-hidden="true"></span>}
          <Icon name={s.icon} size={16} class="text-gold-400" />
          {s.text}
        </li>
      ))}
    </ul>
  </div>

  <div class="pointer-events-none absolute bottom-6 left-1/2 hidden -translate-x-1/2 flex-col items-center gap-3 md:flex" aria-hidden="true">
    <span class="text-[10px] uppercase tracking-[0.3em] text-muted/70">Desliza</span>
    <span class="hero-cue relative block h-10 w-px overflow-hidden bg-white/10"></span>
  </div>
</section>

<script>
  // El vídeo no lleva autoplay en el HTML: con movimiento reducido no se descarga nada (solo el póster).
  const v = document.querySelector<HTMLVideoElement>('[data-hero-video]');
  if (v && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    v.preload = 'auto';
    v.autoplay = true;
    v.play().catch(() => {});
    // fuera de pantalla se pausa: no decodifica fotogramas mientras se lee el resto de la página
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(([e]) => { if (e.isIntersecting) v.play().catch(() => {}); else v.pause(); }).observe(v);
    }
  }
</script>

<style>
  .hero-ping { animation: hero-ping 2.2s cubic-bezier(0, 0, 0.2, 1) infinite; }
  @keyframes hero-ping { 75%, 100% { transform: scale(2.6); opacity: 0; } }
  .hero-cue::after {
    content: ''; position: absolute; inset-inline: 0; top: 0; height: 40%;
    background: linear-gradient(to bottom, transparent, var(--color-gold-400));
    animation: hero-cue 2.4s var(--ease-out-expo) infinite;
  }
  @keyframes hero-cue { from { transform: translateY(-100%); } to { transform: translateY(250%); } }
  @media (prefers-reduced-motion: reduce) {
    .hero-ping, .hero-cue::after { animation: none; }
  }
</style>
