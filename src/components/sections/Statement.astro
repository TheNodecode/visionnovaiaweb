---
// Una afirmación grande a la izquierda y lo que la respalda a la derecha
// (p. ej. «Tu número es tuyo» o «Lo que te llevas de cada jornada»).
import Eyebrow from '../ui/Eyebrow.astro';
import Icon from '../ui/Icon.astro';
import type { Point } from '../../data/blocks';

interface Props {
  id?: string;
  eyebrow: string;
  /** HTML permitido para resaltar en oro con <span class="text-gold">. */
  titleHtml: string;
  lead: string;
  points: Point[];
  tone?: 'dark' | 'light';
}
const { id = 'afirmacion', eyebrow, titleHtml, lead, points, tone = 'dark' } = Astro.props;
---
<section id={id} class:list={['st relative overflow-hidden bg-ink py-16 md:py-24', tone === 'light' && 'section-light']} aria-labelledby={`${id}-title`}>
  <div class="pointer-events-none absolute -right-[15%] top-0 h-[520px] w-[720px] max-w-[160vw] bg-[radial-gradient(closest-side,rgb(217_178_102/0.10),transparent)]" aria-hidden="true"></div>
  <div class="container-x relative grid gap-10 lg:grid-cols-12 lg:gap-16">
    <div class="lg:col-span-5">
      <div class="flex flex-col gap-4 lg:sticky lg:top-32" data-reveal>
        <Eyebrow>{eyebrow}</Eyebrow>
        <h2 id={`${id}-title`} class="font-display text-[clamp(2.6rem,7vw,5rem)] italic leading-[0.98] text-cream text-balance" set:html={titleHtml} />
        <p class="max-w-md text-base leading-relaxed text-muted text-pretty md:text-lg">{lead}</p>
      </div>
    </div>
    <ul class="flex flex-col lg:col-span-7" data-reveal-stagger>
      {points.map((p) => (
        <li class="st-point">
          <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-2xl border border-gold-400/35 bg-gold-400/[0.08] text-gold-200" aria-hidden="true"><Icon name={p.icon} size={20} /></span>
          <div class="min-w-0">
            <h3 class="text-[17px] font-medium leading-snug text-cream md:text-[18px]">{p.title}</h3>
            <p class="mt-1.5 text-[14.5px] leading-relaxed text-muted text-pretty md:text-[15px]">{p.text}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .st-point { display: flex; gap: 18px; padding: 22px 0; border-top: 1px solid rgb(255 255 255 / 0.1); }
  .st-point:first-child { border-top: 0; padding-top: 4px; }
  .section-light .st-point { border-top-color: rgb(10 10 10 / 0.1); }
</style>
