---
import Eyebrow from '../ui/Eyebrow.astro';
import JsonLd from '../seo/JsonLd.astro';

interface Props { items: { q: string; a: string }[]; title?: string }
const { items, title = 'Lo que nos suelen preguntar' } = Astro.props;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((i) => ({ '@type': 'Question', name: i.q, acceptedAnswer: { '@type': 'Answer', text: i.a } })),
};
---
<section class="faq relative bg-ink py-24 md:py-36" aria-labelledby="faq-title">
  <JsonLd data={schema} />
  <div class="container-x grid gap-12 lg:grid-cols-12 lg:gap-16">
    <div class="lg:col-span-4">
      <div class="lg:sticky lg:top-36">
        <div data-reveal><Eyebrow>Preguntas frecuentes</Eyebrow></div>
        <h2 id="faq-title" data-split class="mt-5 font-display text-[44px] italic leading-[1.02] text-cream text-balance md:text-[60px]">{title}</h2>
        <p class="mt-6 max-w-xs text-[15px] leading-relaxed text-muted" data-reveal>
          ¿Te queda alguna duda? Pregúntanos en la llamada de 20 minutos y te respondemos con tu caso delante.
        </p>
      </div>
    </div>

    <div class="lg:col-span-8" data-reveal-stagger>
      {items.map((it) => (
        <details class="faq-item group border-t border-white/10 last:border-b">
          <summary class="flex min-h-11 cursor-pointer list-none items-start justify-between gap-6 py-6 text-left md:py-7">
            <span class="text-[17px] leading-snug text-cream transition-colors group-hover:text-gold-200 md:text-xl">{it.q}</span>
            <span class="faq-plus relative mt-1 flex h-7 w-7 shrink-0 items-center justify-center rounded-full border border-gold-400/40 text-gold-400" aria-hidden="true">
              <svg viewBox="0 0 12 12" class="h-3 w-3" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 1v10M1 6h10" /></svg>
            </span>
          </summary>
          <div class="pb-7 pr-12">
            <p class="max-w-2xl text-[15px] leading-relaxed text-muted text-pretty md:text-base">{it.a}</p>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq { interpolate-size: allow-keywords; }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-plus { transition: transform 0.5s var(--ease-out-expo), background-color 0.3s, color 0.3s; }
  .faq-item[open] .faq-plus { transform: rotate(135deg); background: rgb(217 178 102 / 0.12); color: var(--color-gold-200); }
  .faq-item::details-content {
    block-size: 0; overflow-y: clip;
    transition: block-size 0.5s var(--ease-out-expo), content-visibility 0.5s allow-discrete;
  }
  .faq-item[open]::details-content { block-size: auto; }
</style>
