---
import { SERVICES, SECTORS, TICKETS, ADS } from '../../lib/lead';
import { SITE } from '../../config/site';
import Eyebrow from '../ui/Eyebrow.astro';

interface Props { id?: string; variant?: 'full' | 'compact'; heading?: string; lead?: string; class?: string }
const {
  id = 'formulario',
  variant = 'full',
  heading = 'Cuéntanos tu negocio y te enseñamos cómo quedaría tu sistema',
  lead = 'Cuatro preguntas rápidas y tus datos: menos de un minuto. Después reservas una llamada de 20 minutos, sin compromiso.',
  class: cls = '',
} = Astro.props;
const full = variant === 'full';

const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);

// Iconos en línea (trazo, 24×24). Uno por opción, en el mismo orden que los arrays de lead.ts.
const ICONS = {
  servicio: [
    'M3 11v2a1 1 0 0 0 1 1h2l5 4V6l-5 4H4a1 1 0 0 0-1 1Z M15 9a3 3 0 0 1 0 6 M18 6a7 7 0 0 1 0 12',
    'M4 5h16v14H4z M4 9h16 M8 5l2 4 M13 5l2 4 M10.5 12.5l4 2.5-4 2.5z',
    'M4 5h16v10H9l-5 4z M8 9h8 M8 12h5',
    'M12 3 3 8l9 5 9-5-9-5Z M3 12l9 5 9-5 M3 16l9 5 9-5',
  ],
  sector: [
    'M7.5 3C5.3 3 3.8 4.7 3.8 7c0 2.5 1.2 4 1.8 6.5.5 2.2.8 7.5 2.7 7.5 1.6 0 1.6-4.5 3.7-4.5s2.1 4.5 3.7 4.5c1.9 0 2.2-5.3 2.7-7.5.6-2.5 1.8-4 1.8-6.5 0-2.3-1.5-4-3.7-4-1.9 0-2.8 1-4.5 1S9.4 3 7.5 3Z',
    'M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8z M19 15.5l.7 1.8 1.8.7-1.8.7-.7 1.8-.7-1.8-1.8-.7 1.8-.7z',
    'M3 11 12 4l9 7 M5 9.5V20h14V9.5 M10 20v-6h4v6',
    'M3 17h18 M5 17a7 7 0 0 1 14 0 M10 10.2V6h4v4.2 M4 17v2.5h16V17',
    'M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18Z M12 8v8 M8 12h8',
  ],
  publicidad_actual: [
    'M8 8c-2.2 0-4 1.8-4 4s1.8 4 4 4c3 0 5-8 8-8 2.2 0 4 1.8 4 4s-1.8 4-4 4c-3 0-5-8-8-8Z',
    'M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18Z M3 12h18 M12 3c2.4 2.5 3.5 5.5 3.5 9s-1.1 6.5-3.5 9c-2.4-2.5-3.5-5.5-3.5-9s1.1-6.5 3.5-9Z',
    'M4 4v5h5 M5.6 15a7 7 0 1 0 1.3-7.4L4 9',
    'M12 20v-8 M12 12c0-4-3-6-7-6 0 4 3 6 7 6Z M12 14.5c0-3 2.5-5 6-5 0 3-2.5 5-6 5Z',
  ],
};
const BARS = ['M5 20v-4', 'M10 20v-8', 'M15 20V8', 'M20 20V4'];

const singleSteps = [
  { n: 2, field: 'sector', title: '¿A qué se dedica tu negocio?', sub: 'Así te enseñamos ejemplos de tu sector.', options: SECTORS as readonly string[] },
  { n: 3, field: 'ticket_medio', title: '¿Cuánto vale de media un cliente para ti?', sub: 'Lo que te deja un cliente nuevo, más o menos.', options: TICKETS as readonly string[] },
  { n: 4, field: 'publicidad_actual', title: '¿Ya invertís en publicidad?', sub: 'Para saber desde dónde partimos.', options: ADS as readonly string[] },
];
const calendlyFallback = SITE.calendly;
const wa = `${SITE.whatsapp}?text=${encodeURIComponent('Hola, acabo de rellenar el formulario de la web de Visión Nova')}`;
---
<section id={id} data-lead-form data-variant={variant} data-calendly-url={SITE.calendly}
  class:list={['lead-form scroll-mt-24', full ? 'py-20 md:py-28' : 'py-10', cls]}>
  <div class:list={['container-x', full ? 'grid items-start gap-10 lg:grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)] lg:gap-16' : 'max-w-3xl']}>
    {full && (
      <aside class="flex flex-col gap-5 lg:sticky lg:top-32">
        <Eyebrow>Primer paso</Eyebrow>
        <h2 class="font-display text-[clamp(2.25rem,5vw,3.5rem)] leading-[1.05] text-cream text-balance">{heading}</h2>
        <p class="max-w-md text-base leading-relaxed text-muted text-pretty">{lead}</p>
        <ul class="mt-2 flex flex-col gap-3 text-sm text-cream/90">
          <li class="flex items-start gap-3"><span class="lf-tick" aria-hidden="true"></span>Hablas con quien monta el sistema, no con un comercial.</li>
          <li class="flex items-start gap-3"><span class="lf-tick" aria-hidden="true"></span>Sin compromiso: si no te encaja, te lo decimos claro.</li>
          <li class="flex items-start gap-3"><span class="lf-tick" aria-hidden="true"></span>Tus datos solo se usan para preparar la llamada.</li>
        </ul>
      </aside>
    )}

    <form data-lf-form novalidate class="lf-card glass-strong relative rounded-[28px] shadow-[0_30px_80px_-30px_rgb(0_0_0/0.8)]">
      <div class="lf-head flex items-center justify-between gap-4 px-5 pt-5 sm:px-8 sm:pt-7">
        <p class="text-[12px] font-medium uppercase tracking-[0.2em] text-muted" data-lf-label>Paso 1 de 5</p>
        <button type="button" data-lf-back hidden
          class="inline-flex min-h-11 items-center gap-1.5 rounded-full px-3 text-[13px] text-muted transition-colors hover:text-cream">
          <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M15 6l-6 6 6 6" stroke-linecap="round" stroke-linejoin="round" /></svg>
          Atrás
        </button>
      </div>
      <div class="mx-5 mt-4 h-[2px] overflow-hidden rounded-full bg-white/10 sm:mx-8" aria-hidden="true">
        <div data-lf-bar class="lf-bar h-full w-full origin-left rounded-full" style="transform: scaleX(0.2)"></div>
      </div>

      <div class="lf-stage px-5 pb-5 pt-7 sm:px-8 sm:pb-8 sm:pt-9">
        <!-- Paso 1: multiselección -->
        <div class="lf-step" data-step="1">
          <h3 class="lf-title" tabindex="-1" data-lf-title>¿Qué te gustaría conseguir?</h3>
          <p class="lf-sub">Puedes marcar varias.</p>
          <div class="lf-opts" data-field="servicio" data-multi>
            {SERVICES.map((v, i) => (
              <button type="button" class="lf-opt" aria-pressed="false" data-opt={v}>
                <svg viewBox="0 0 24 24" class="lf-ico" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d={ICONS.servicio[i]} stroke-linecap="round" stroke-linejoin="round" /></svg>
                <span class="flex-1">{cap(v)}</span>
                <span class="lf-check" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M5 12.5l4.5 4.5L19 7.5" stroke-linecap="round" stroke-linejoin="round" /></svg></span>
              </button>
            ))}
          </div>
          <p class="lf-msg" data-lf-hint="1" aria-live="polite"></p>
          <div class="lf-actions">
            <button type="button" data-lf-next class="lf-next bg-gold">Siguiente <span aria-hidden="true">→</span></button>
          </div>
        </div>

        <!-- Pasos 2–4: respuesta única -->
        {singleSteps.map((s) => (
          <div class="lf-step" data-step={s.n} hidden>
            <h3 class="lf-title" tabindex="-1" data-lf-title>{s.title}</h3>
            <p class="lf-sub">{s.sub}</p>
            <div class="lf-opts" data-field={s.field}>
              {s.options.map((v, i) => (
                <button type="button" class="lf-opt" aria-pressed="false" data-opt={v}>
                  {s.field === 'ticket_medio'
                    ? <svg viewBox="0 0 24 24" class="lf-ico" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">{BARS.map((d, b) => <path d={d} stroke-linecap="round" opacity={b <= i ? 1 : 0.25} />)}</svg>
                    : <svg viewBox="0 0 24 24" class="lf-ico" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d={ICONS[s.field as 'sector' | 'publicidad_actual'][i]} stroke-linecap="round" stroke-linejoin="round" /></svg>}
                  <span class="flex-1">{cap(v)}</span>
                  <span class="lf-check" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M5 12.5l4.5 4.5L19 7.5" stroke-linecap="round" stroke-linejoin="round" /></svg></span>
                </button>
              ))}
            </div>
            {s.n === 2 && <div data-lf-otro-slot></div>}
          </div>
        ))}

        <!-- Paso 5: contacto -->
        <div class="lf-step" data-step="5" hidden>
          <h3 class="lf-title" tabindex="-1" data-lf-title>¿Cómo te contactamos?</h3>
          <p class="lf-sub">Solo para preparar la llamada. Nada de listas ni de spam.</p>
          <div class="grid gap-3 sm:grid-cols-2">
            <div class="lf-field">
              <input id={`${id}-nombre`} name="nombre" type="text" autocomplete="name" autocapitalize="words" enterkeyhint="next" placeholder=" " aria-describedby={`${id}-nombre-msg`} />
              <label for={`${id}-nombre`}>Tu nombre</label>
              <p id={`${id}-nombre-msg`} class="lf-msg" data-msg-for="nombre"></p>
            </div>
            <div class="lf-field">
              <input id={`${id}-empresa`} name="empresa" type="text" autocomplete="organization" enterkeyhint="next" placeholder=" " aria-describedby={`${id}-empresa-msg`} />
              <label for={`${id}-empresa`}>Negocio o empresa</label>
              <p id={`${id}-empresa-msg`} class="lf-msg" data-msg-for="empresa"></p>
            </div>
            <div class="lf-field">
              <input id={`${id}-email`} name="email" type="email" inputmode="email" autocomplete="email" autocapitalize="off" spellcheck="false" enterkeyhint="next" placeholder=" " aria-describedby={`${id}-email-msg`} />
              <label for={`${id}-email`}>Email</label>
              <p id={`${id}-email-msg`} class="lf-msg" data-msg-for="email"></p>
            </div>
            <div class="lf-field">
              <input id={`${id}-telefono`} name="telefono" type="tel" inputmode="tel" autocomplete="tel" enterkeyhint="next" placeholder=" " aria-describedby={`${id}-telefono-msg`} />
              <label for={`${id}-telefono`}>Teléfono</label>
              <p id={`${id}-telefono-msg`} class="lf-msg" data-msg-for="telefono"></p>
            </div>
            <div class="lf-field sm:col-span-2">
              <input id={`${id}-web`} name="web" type="url" inputmode="url" autocomplete="url" autocapitalize="off" spellcheck="false" enterkeyhint="next" placeholder=" " />
              <label for={`${id}-web`}>Web (opcional)</label>
            </div>
            <div class="lf-field sm:col-span-2">
              <textarea id={`${id}-mensaje`} name="mensaje" rows="3" placeholder=" "></textarea>
              <label for={`${id}-mensaje`}>¿Algo más que debamos saber? (opcional)</label>
            </div>
          </div>
          <input name="_gotcha" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
          <label class="mt-5 flex min-h-11 cursor-pointer items-start gap-3 text-sm leading-relaxed text-muted">
            <input type="checkbox" name="privacidad" class="lf-checkbox" aria-describedby={`${id}-privacidad-msg`} />
            <span>He leído y acepto la <a href="/politica-privacidad" target="_blank" rel="noopener" class="text-cream underline underline-offset-4 hover:text-gold-200">política de privacidad</a>.</span>
          </label>
          <p id={`${id}-privacidad-msg`} class="lf-msg" data-msg-for="privacidad"></p>
          <div class="lf-actions">
            <button type="submit" data-lf-submit class="lf-next bg-gold">
              <span class="lf-spinner" aria-hidden="true"></span>
              <span>Ver huecos disponibles <span aria-hidden="true">→</span></span>
            </button>
          </div>
        </div>

        <!-- Paso 6: Calendly -->
        <div class="lf-step" data-step="6" hidden>
          <h3 class="lf-title" tabindex="-1" data-lf-title>Elige el hueco que mejor te venga</h3>
          <p class="lf-sub">20 minutos · te enseñamos cómo quedaría tu sistema</p>
          <div class="lf-cal" data-lf-calendly></div>
          <div class="mt-5 flex flex-col gap-2 text-sm text-muted sm:flex-row sm:items-center sm:justify-between">
            <p>¿Prefieres WhatsApp? <a href={wa} target="_blank" rel="noopener" class="text-cream underline underline-offset-4 hover:text-gold-200">Escríbenos</a></p>
            <p><a href={calendlyFallback} target="_blank" rel="noopener" class="underline underline-offset-4 hover:text-cream">Abrir el calendario en otra pestaña</a></p>
          </div>
        </div>

        <!-- Pantalla "software" (perfil no cualificado) -->
        <div class="lf-step" data-step="software" hidden>
          <h3 class="lf-title" tabindex="-1" data-lf-title>Gracias, <span data-lf-name></span>.</h3>
          <p class="mt-4 max-w-xl text-base leading-relaxed text-muted text-pretty">
            Por lo que nos cuentas, ahora mismo te encaja mejor nuestro software Nova: CRM con IA y WhatsApp desde 59 €/mes, sin agencia.
          </p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center">
            <a href={SITE.appUrl} target="_blank" rel="noopener" class="lf-next bg-gold sm:w-auto">Ver planes de Nova <span aria-hidden="true">→</span></a>
            <button type="button" data-lf-goto="6" class="inline-flex min-h-12 items-center justify-center px-4 text-sm text-cream underline-offset-4 hover:text-gold-200 hover:underline">Prefiero hablar igualmente</button>
          </div>
        </div>
      </div>

      <template data-lf-otro-tpl>
        <div class="lf-otro">
          <label for={`${id}-sector-otro`} class="sr-only">¿A qué se dedica tu negocio?</label>
          <input id={`${id}-sector-otro`} name="sector_otro" type="text" autocomplete="off" enterkeyhint="next"
            placeholder="Por ejemplo: peluquería, gimnasio, despacho…" aria-describedby={`${id}-sector-otro-msg`} class="lf-input-plain" />
          <p id={`${id}-sector-otro-msg`} class="lf-msg" data-msg-for="sector_otro"></p>
          <div class="lf-actions">
            <button type="button" data-lf-next class="lf-next bg-gold">Siguiente <span aria-hidden="true">→</span></button>
          </div>
        </div>
      </template>
    </form>
  </div>
</section>

<style is:global>
  .lf-tick { margin-top: 0.45em; height: 6px; width: 6px; flex: none; border-radius: 999px; background: var(--color-gold-400); box-shadow: 0 0 12px rgb(217 178 102 / 0.6); }
  .lf-bar { background: linear-gradient(90deg, var(--color-gold-200), var(--color-gold-400) 50%, var(--color-gold-600));
    transition: transform 0.6s var(--ease-out-expo, cubic-bezier(0.16, 1, 0.3, 1)); }
  .lf-stage { display: grid; }
  .lf-step { grid-area: 1 / 1; min-width: 0; }
  .lf-step[data-anim='in'] { animation: lf-in 350ms var(--ease-out-expo, cubic-bezier(0.16, 1, 0.3, 1)) both; }
  .lf-step[data-anim='out'] { animation: lf-out 350ms var(--ease-out-expo, cubic-bezier(0.16, 1, 0.3, 1)) both; pointer-events: none; }
  @keyframes lf-in { from { opacity: 0; transform: translateX(calc(24px * var(--lf-dir, 1))); } }
  @keyframes lf-out { to { opacity: 0; transform: translateX(calc(-24px * var(--lf-dir, 1))); } }

  .lf-title { font-family: var(--font-display); font-style: italic; font-size: clamp(28px, 4.2vw, 40px); line-height: 1.08;
    color: var(--color-cream); text-wrap: balance; outline: none; }
  .lf-sub { margin-top: 0.6rem; font-size: 15px; color: var(--color-muted); }
  .lf-opts { margin-top: 1.75rem; display: grid; gap: 0.75rem; }
  @media (min-width: 640px) { .lf-opts { grid-template-columns: repeat(2, minmax(0, 1fr)); } }

  .lf-opt { display: flex; min-height: 60px; width: 100%; align-items: center; gap: 0.85rem; border-radius: 18px; padding: 0.9rem 1rem;
    text-align: left; font-size: 15px; line-height: 1.3; color: var(--color-cream); cursor: pointer;
    background: rgb(255 255 255 / 0.035); border: 1px solid rgb(255 255 255 / 0.1);
    transition: background-color 0.25s, border-color 0.25s, transform 0.2s var(--ease-out-expo, ease), box-shadow 0.3s; -webkit-tap-highlight-color: transparent; }
  @media (hover: hover) { .lf-opt:hover { background: rgb(255 255 255 / 0.07); border-color: rgb(255 255 255 / 0.2); } }
  .lf-opt:active { transform: scale(0.985); }
  .lf-opt[aria-pressed='true'] { border-color: rgb(217 178 102 / 0.75); background: rgb(217 178 102 / 0.09);
    box-shadow: 0 0 0 1px rgb(217 178 102 / 0.35), 0 12px 30px -16px rgb(217 178 102 / 0.55); }
  .lf-ico { height: 22px; width: 22px; flex: none; color: var(--color-gold-400); }
  .lf-check { display: grid; place-items: center; height: 22px; width: 22px; flex: none; border-radius: 999px;
    border: 1px solid rgb(255 255 255 / 0.2); color: transparent; transition: all 0.25s; }
  .lf-check svg { height: 13px; width: 13px; }
  .lf-opt[aria-pressed='true'] .lf-check { background: var(--color-gold-400); border-color: var(--color-gold-400); color: #1a1408; }

  .lf-actions { margin-top: 1.5rem; display: flex; justify-content: flex-end; }
  .lf-next { display: inline-flex; min-height: 52px; width: 100%; align-items: center; justify-content: center; gap: 0.6rem;
    border-radius: 999px; padding: 0 1.75rem; font-size: 15px; font-weight: 500; cursor: pointer;
    box-shadow: 0 10px 30px -10px rgb(217 178 102 / 0.6); transition: filter 0.25s, transform 0.2s var(--ease-out-expo, ease); }
  .lf-next:hover { filter: brightness(1.08); }
  .lf-next:active { transform: scale(0.97); }
  .lf-next[disabled] { cursor: progress; filter: saturate(0.7); }
  @media (min-width: 640px) { .lf-next { width: auto; } }
  @media (max-width: 639px) {
    .lf-actions { position: sticky; bottom: env(safe-area-inset-bottom); z-index: 2; margin-inline: -0.5rem; padding: 0.75rem 0.5rem 0.75rem;
      background: linear-gradient(to top, rgb(18 18 18 / 0.92) 60%, rgb(18 18 18 / 0)); }
  }

  @media (max-width: 639px) {
    a.fixed[href^='https://wa.me'] { transition: opacity 0.3s, visibility 0.3s, transform 0.3s var(--ease-out-expo, ease); }
    html[data-form-in-view] a.fixed[href^='https://wa.me'] { opacity: 0; transform: scale(0.8); pointer-events: none; visibility: hidden; }
  }

  .lf-spinner { display: none; height: 16px; width: 16px; border-radius: 999px; border: 2px solid rgb(26 20 8 / 0.25); border-top-color: #1a1408;
    animation: lf-spin 0.7s linear infinite; }
  [data-lf-submit][aria-busy='true'] .lf-spinner { display: inline-block; }
  @keyframes lf-spin { to { transform: rotate(360deg); } }

  .lf-field { position: relative; }
  .lf-field input, .lf-field textarea, .lf-input-plain {
    display: block; width: 100%; border-radius: 16px; font-size: 16px; color: var(--color-cream);
    background: rgb(0 0 0 / 0.25); border: 1px solid rgb(255 255 255 / 0.12); transition: border-color 0.2s, background-color 0.2s, box-shadow 0.2s; }
  .lf-field input { height: 60px; padding: 22px 16px 6px; }
  .lf-field textarea { min-height: 104px; padding: 28px 16px 10px; resize: vertical; }
  .lf-input-plain { height: 56px; padding: 0 16px; margin-top: 1rem; }
  .lf-input-plain::placeholder { color: rgb(163 158 150 / 0.7); }
  .lf-field input:focus, .lf-field textarea:focus, .lf-input-plain:focus {
    outline: none; border-color: rgb(217 178 102 / 0.7); background: rgb(0 0 0 / 0.35); box-shadow: 0 0 0 3px rgb(217 178 102 / 0.15); }
  .lf-field input[aria-invalid='true'], .lf-input-plain[aria-invalid='true'] { border-color: rgb(240 140 120 / 0.8); }
  .lf-field label { position: absolute; left: 17px; top: 19px; font-size: 16px; color: var(--color-muted); pointer-events: none;
    transform-origin: left top; transition: transform 0.25s var(--ease-out-expo, ease), color 0.2s; white-space: nowrap; max-width: calc(100% - 32px); overflow: hidden; text-overflow: ellipsis; }
  .lf-field input:focus + label, .lf-field input:not(:placeholder-shown) + label, .lf-field input:-webkit-autofill + label,
  .lf-field textarea:focus + label, .lf-field textarea:not(:placeholder-shown) + label { transform: translateY(-11px) scale(0.75); }
  .lf-field input:focus + label, .lf-field textarea:focus + label { color: var(--color-gold-200); }
  .lf-field input:-webkit-autofill { -webkit-text-fill-color: var(--color-cream); box-shadow: 0 0 0 100px #16140f inset; caret-color: var(--color-cream); }

  .lf-msg { font-size: 13px; color: #f0a08c; min-height: 0; }
  .lf-msg:not(:empty) { margin-top: 0.4rem; padding-left: 4px; }
  .lf-checkbox { margin-top: 2px; height: 20px; width: 20px; flex: none; accent-color: var(--color-gold-400); cursor: pointer; }

  .lf-cal { margin-top: 1.5rem; height: min(720px, 80svh); overflow: hidden; border-radius: 18px;
    background: rgb(0 0 0 / 0.25) radial-gradient(circle at 50% 40%, rgb(217 178 102 / 0.08), transparent 60%); }
  @media (min-width: 768px) { .lf-cal { height: 680px; } }
  .lf-cal iframe { width: 100%; height: 100%; }
</style>

<script>
  import { initLeadForms } from '../../scripts/lead-form';
  initLeadForms();
</script>
