---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
import Eyebrow from '../components/ui/Eyebrow.astro';
import { SITE } from '../config/site';
---
<BaseLayout title="Gracias | Visión Nova" description="Hemos recibido tus datos. Te escribimos muy pronto." path="/gracias" noindex>
  <section class="container-x flex min-h-[70svh] flex-col items-center justify-center gap-6 py-32 text-center">
    <Eyebrow>Recibido</Eyebrow>
    <h1 class="font-display text-[clamp(2.5rem,7vw,4.5rem)] italic leading-[1.05] text-cream text-balance">Gracias. Ya tenemos tus datos.</h1>
    <p class="max-w-xl text-base leading-relaxed text-muted text-pretty">
      Te escribimos en persona muy pronto para preparar la llamada. Si te corre prisa, háblanos por WhatsApp.
    </p>
    <div class="mt-2 flex flex-col gap-3 sm:flex-row">
      <Button href={SITE.whatsapp} target="_blank" rel="noopener">Escribir por WhatsApp</Button>
      <Button href="/" variant="glass">Volver al inicio</Button>
    </div>
  </section>
</BaseLayout>
