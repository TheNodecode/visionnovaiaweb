---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/sections/PageHero.astro';
import FeatureGrid from '../components/sections/FeatureGrid.astro';
import Eyebrow from '../components/ui/Eyebrow.astro';
import type { IconName } from '../components/ui/icon-names';
import { SITE, appLink } from '../config/site';

const path = '/software-nova';
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'NØVA',
    applicationCategory: 'BusinessApplication',
    operatingSystem: 'Web',
    url: SITE.appUrl,
    description: 'CRM con WhatsApp oficial y asistente de IA para negocios de servicios: fichas de contacto, pipeline, agenda, recordatorios y seguimiento.',
    publisher: { '@id': SITE.url + '/#org' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: SITE.url + '/' },
      { '@type': 'ListItem', position: 2, name: 'Software NØVA', item: SITE.url + path },
    ],
  },
];

const features: { title: string; text: string; icon: IconName }[] = [
  { icon: 'crm', title: 'Ficha por contacto y pipeline', text: 'Origen, etapa, notas, tareas, documentos y etiquetas en cada ficha, con un pipeline por etapas adaptado a tu sector.' },
  { icon: 'chat', title: 'Bandeja compartida de WhatsApp', text: 'WhatsApp con la API oficial, varios números y la IA en pausa cuando entra una persona del equipo a la conversación.' },
  { icon: 'spark', title: 'Asistente de IA en WhatsApp y en tu web', text: 'Atiende, califica, propone horas libres de la agenda real y reserva sin dobles reservas. También cancela o cambia citas y apunta a la lista de espera.' },
  { icon: 'calendar', title: 'Agenda por profesional y sala', text: 'Recordatorios de cita por email y con plantilla de WhatsApp, y un mensaje de reprogramación cuando alguien no viene.' },
  { icon: 'users', title: 'Reparto de contactos', text: 'Cada contacto con alguien asignado y avisos al asesor por la app, por email y por WhatsApp.' },
  { icon: 'bolt', title: 'Plantillas y automatizaciones', text: 'Plantillas de WhatsApp aprobadas por Meta, automatizaciones por etapa o por días y campañas de email con baja de un clic.' },
];

const sectors = ['Clínica y salud', 'Belleza y uñas', 'Inmobiliaria', 'Reformas', 'Educación', 'Restaurante', 'Agencia de viajes y migración', 'Servicios profesionales', 'Tienda'];
const limits = [
  'No es software de historia clínica: no tiene odontograma, radiografías ni facturación sanitaria. Se usa junto al programa que ya utilices.',
  'No garantiza resultados: ordena y atiende tus contactos, pero vender sigue dependiendo de tu equipo y de tu oferta.',
  'Hoy no tiene integración con Flowww.',
];
---
<BaseLayout
  title="Software NØVA: CRM con WhatsApp oficial e IA | Visión Nova"
  description="NØVA es nuestro CRM con WhatsApp oficial y asistente de IA para negocios de servicios: fichas, agenda y seguimiento. Prueba 3 días, sin permanencia."
  path={path}
  schema={schema}
>
  <PageHero
    eyebrow="Software NØVA"
    title="Tu WhatsApp, tu agenda y tus clientes,"
    titleAccent="en un solo sitio."
    lead="NØVA es nuestro software, creado por Visión Nova: un CRM con WhatsApp oficial e IA para negocios de servicios. Junta tus conversaciones, tus citas y tus clientes, con un asistente que atiende en WhatsApp y en tu web."
    ctaLabel="Prefiero que me lo montéis"
    bullets={['WhatsApp Business API oficial', 'Asistente de IA en WhatsApp y en tu web', 'Prueba gratis de 3 días, sin permanencia']}
  />

  <FeatureGrid eyebrow="Qué hace NØVA" title="Lo que necesitas para atender y no perder ningún contacto." items={features} />

  <section class="relative bg-ink py-16 md:py-24" aria-labelledby="plans-title">
    <div class="container-x relative">
      <div class="mx-auto flex max-w-3xl flex-col items-center gap-4 text-center" data-reveal>
        <Eyebrow>Cómo empezar</Eyebrow>
        <h2 id="plans-title" class="font-display text-[clamp(2.25rem,6vw,4rem)] italic leading-[1.05] text-cream text-balance">
          Pruébalo 3 días, <span class="text-gold">sin permanencia.</span>
        </h2>
        <p class="max-w-2xl text-base leading-relaxed text-muted text-pretty md:text-lg">
          Hay planes según el tamaño de tu equipo. Los precios y los límites vigentes de cada uno están siempre actualizados en la app.
        </p>
      </div>

      <div class="mt-12 grid gap-5 lg:grid-cols-2" data-reveal-stagger>
        <div class="glass rounded-[32px] p-7 md:p-9">
          <h3 class="font-display text-[30px] italic leading-none text-cream">Sectores preparados</h3>
          <ul class="mt-6 flex flex-wrap gap-2">
            {sectors.map((t) => <li class="rounded-full border border-white/10 px-4 py-2 text-[14px] text-cream/85">{t}</li>)}
          </ul>
        </div>
        <div class="glass rounded-[32px] p-7 md:p-9">
          <h3 class="font-display text-[30px] italic leading-none text-cream">Lo que NØVA no es</h3>
          <ul class="mt-6 flex flex-col gap-3 text-[15px] text-cream/85">
            {limits.map((it) => (
              <li class="flex items-start gap-3">
                <svg viewBox="0 0 16 16" class="mt-[4px] h-3.5 w-3.5 shrink-0 text-gold-400" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M4 4l8 8M12 4l-8 8" /></svg>
                <span class="text-pretty">{it}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <div class="mt-10 flex flex-col items-center gap-3 text-center">
        <a href={appLink('software-nova', { path: '/empezar' })} rel="noopener"
          class="inline-flex min-h-14 w-full items-center justify-center gap-2 rounded-full bg-gold px-8 text-sm font-medium shadow-[0_8px_30px_-8px_rgb(217_178_102/0.55)] transition duration-300 ease-out-expo hover:brightness-110 active:scale-[0.97] sm:w-auto">
          Probar NØVA 3 días gratis
          <svg viewBox="0 0 16 16" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M5 11 11 5M6 5h5v5" /></svg>
        </a>
        <a href={appLink('software-nova-planes')} rel="noopener" class="text-sm text-muted underline-offset-4 hover:text-cream hover:underline">Ver planes y precios en la app</a>
      </div>
    </div>
  </section>

  <section class="relative bg-ink pb-24 md:pb-36" aria-labelledby="novascale-title">
    <div class="container-x">
      <div class="relative mx-auto max-w-5xl overflow-hidden rounded-[40px] border border-gold-400/20 bg-[linear-gradient(180deg,rgb(217_178_102/0.06),rgb(18_18_18/0.6))] px-6 py-14 text-center sm:px-12 md:py-20" data-reveal>
        <span class="absolute inset-x-16 top-0 h-px bg-gradient-to-r from-transparent via-gold-200/80 to-transparent" aria-hidden="true"></span>
        <h2 id="novascale-title" class="mx-auto max-w-3xl font-display text-[34px] italic leading-[1.08] text-cream text-balance md:text-[56px]">
          ¿Prefieres que lo montemos todo por ti? <span class="text-gold">Eso es NovaScale.</span>
        </h2>
        <p class="mx-auto mt-6 max-w-xl text-base leading-relaxed text-muted text-pretty md:text-lg">
          Grabamos tu contenido, lanzamos tus anuncios en Meta y dejamos NØVA configurado y conectado para que cada contacto se atienda y se filtre.
        </p>
        <a href="/#sistema" class="mt-9 inline-flex min-h-14 w-full items-center justify-center gap-2 rounded-full bg-gold px-8 text-sm font-medium shadow-[0_8px_30px_-8px_rgb(217_178_102/0.55)] transition duration-300 ease-out-expo hover:brightness-110 active:scale-[0.97] sm:w-auto">
          Ver cómo funciona NovaScale
          <svg viewBox="0 0 16 16" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" /></svg>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
