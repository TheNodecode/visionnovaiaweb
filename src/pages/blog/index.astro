---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaBand from '../../components/sections/CtaBand.astro';
import { SITE } from '../../config/site';
import { formatDate } from '../../lib/blog';

const posts = (await getCollection('blog')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf() || a.id.localeCompare(b.id));

const schema = [{
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: SITE.url + '/' },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: SITE.url + '/blog' },
  ],
}];
---
<BaseLayout
  title="Blog de IA para negocios | Visión Nova"
  description="Guías claras sobre chatbots, agentes de voz, recepcionistas virtuales y visibilidad en ChatGPT para negocios de Barcelona, Málaga y toda España."
  path="/blog"
  schema={schema}
>
  <section class="relative bg-ink pb-10 pt-[calc(env(safe-area-inset-top)+140px)] md:pb-16 md:pt-44">
    <div class="container-x">
      <p class="inline-flex items-center gap-2 text-[11px] font-medium uppercase tracking-[0.25em] text-gold-400" data-reveal>
        <span class="h-px w-6 bg-gold-400/60" aria-hidden="true"></span>Blog
      </p>
      <h1 class="mt-5 max-w-4xl font-display text-[44px] italic leading-[1.02] text-cream text-balance md:text-[80px]" data-reveal>
        Guías para automatizar sin perder el trato humano
      </h1>
      <p class="mt-6 max-w-2xl text-base leading-relaxed text-muted text-pretty md:text-lg" data-reveal>
        Artículos prácticos sobre chatbots, agentes de voz y visibilidad en asistentes de IA, escritos para quien dirige un negocio y no tiene tiempo para jerga.
      </p>
    </div>
  </section>

  <section class="relative bg-ink pb-24 md:pb-32" aria-label="Artículos del blog">
    <div class="container-x">
      <ul class="grid gap-4 md:grid-cols-2 md:gap-6" data-reveal-stagger>
        {posts.map((p) => (
          <li>
            <a href={`/blog/${p.id}`} class="glass group flex h-full flex-col rounded-3xl p-6 transition-colors duration-300 hover:border-gold-400/30 md:p-8">
              <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-[11px] uppercase tracking-[0.18em] text-muted">
                <time datetime={p.data.date.toISOString().slice(0, 10)}>{formatDate(p.data.date)}</time>
                {p.data.readTime && <span aria-hidden="true">·</span>}
                {p.data.readTime && <span>{p.data.readTime} min de lectura</span>}
              </div>
              <h2 class="mt-4 font-display text-[28px] italic leading-[1.1] text-cream text-balance transition-colors group-hover:text-gold-200 md:text-[34px]">{p.data.title}</h2>
              <p class="mt-4 text-[15px] leading-relaxed text-muted text-pretty">{p.data.description}</p>
              <span class="mt-6 inline-flex min-h-11 items-center gap-2 pt-2 text-sm font-medium text-gold-200 md:mt-auto">
                Leer artículo
                <svg viewBox="0 0 16 16" class="h-3.5 w-3.5 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" /></svg>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <CtaBand title="¿Hablamos de tu caso?" lead="Cuéntanos cómo te contactan tus clientes hoy y vemos si el sistema encaja con tu negocio." />
</BaseLayout>
